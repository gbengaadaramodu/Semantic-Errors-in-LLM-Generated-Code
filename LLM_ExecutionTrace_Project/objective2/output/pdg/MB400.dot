digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def tuple_size(my_tuple): | W:my_tuple,tuple_size", fillcolor="lightgreen"];
    "2" [label="L2: return sys.getsizeof(my_tuple) | R:my_tuple,sys", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_tuple)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}