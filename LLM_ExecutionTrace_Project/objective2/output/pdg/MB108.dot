digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def Find_Min_Length(list_of_lists): | W:list_of_lists,Find_Min_Length", fillcolor="lightgreen"];
    "2" [label="L2: return min(len(l) for l in list_of_lists) | W:l | R:l,len,list_of_lists,min", fillcolor="salmon"];

    "1" -> "2" [label="DATA(list_of_lists)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}