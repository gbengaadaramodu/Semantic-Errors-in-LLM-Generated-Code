digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def replace_spaces(my_string): | W:my_string,replace_spaces", fillcolor="lightgreen"];
    "2" [label="L2: return my_string.replace(\" \", \"%20\") | R:my_string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}