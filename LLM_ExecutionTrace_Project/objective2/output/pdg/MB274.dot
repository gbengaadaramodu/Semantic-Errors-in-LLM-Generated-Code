digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def text_starta_endb(string): | W:string,text_starta_endb", fillcolor="lightgreen"];
    "2" [label="L2: return re.match(r\"a.*b$\", string) is not None | R:re,string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}