digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def is_sublist(my_list, sublist): | W:my_list,sublist,is_sublist", fillcolor="lightgreen"];
    "2" [label="L2: return sublist in my_list | R:my_list,sublist", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="DATA(sublist)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}