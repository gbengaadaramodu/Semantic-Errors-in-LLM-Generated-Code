digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def k_smallest_pairs(arr1, arr2, k): | W:arr1,arr2,k,k_smallest_pairs", fillcolor="lightgreen"];
    "2" [label="L2: result = [] | W:result", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(k): | W:i | R:k,range", fillcolor="lightgreen"];
    "4" [label="L4: result.append([arr1[i], arr2[i]]) | R:arr1,arr2,i,result", fillcolor="lightgreen"];
    "5" [label="L5: return result | R:result", fillcolor="salmon"];

    "1" -> "3" [label="DATA(k)", style="solid"];
    "1" -> "4" [label="DATA(arr1)", style="solid"];
    "1" -> "4" [label="DATA(arr2)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "2" -> "4" [label="DATA(result)", style="solid"];
    "2" -> "5" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}