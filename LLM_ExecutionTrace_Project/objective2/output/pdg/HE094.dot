digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def x_or_y(n, x, y): | W:n,x,y,x_or_y", fillcolor="lightgreen"];
    "2" [label="L2: if is_prime(n): | R:is_prime,n", fillcolor="salmon"];
    "3" [label="L3: return x | R:x", fillcolor="lightgrey"];
    "4" [label="L5: return y | R:y", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "3" [label="DATA(x)", style="solid"];
    "1" -> "4" [label="DATA(y)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "2" -> "4" [label="CONTROL(If)", style="dashed"];
}