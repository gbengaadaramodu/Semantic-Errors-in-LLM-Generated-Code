digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def centered_hexagonal_number(n): | W:n,centered_hexagonal_number", fillcolor="lightgreen"];
    "2" [label="L2: return int((2*n - 1)*(2*n - 1) + (2*n - 1)) | R:int,n", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}