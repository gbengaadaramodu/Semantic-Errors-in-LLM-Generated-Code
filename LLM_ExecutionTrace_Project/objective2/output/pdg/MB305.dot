digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def two_unique_nums(my_lists): | W:my_lists,two_unique_nums", fillcolor="lightgreen"];
    "2" [label="L2: unique_nums = [] | W:unique_nums", fillcolor="lightgreen"];
    "3" [label="L3: for num in my_lists: | W:num | R:my_lists", fillcolor="lightgreen"];
    "4" [label="L4: if num not in unique_nums: | R:num,unique_nums", fillcolor="lightgreen"];
    "5" [label="L5: unique_nums.append(num) | R:num,unique_nums", fillcolor="lightgreen"];
    "6" [label="L6: return unique_nums | R:unique_nums", fillcolor="salmon"];

    "1" -> "3" [label="DATA(my_lists)", style="solid"];
    "3" -> "4" [label="DATA(num)", style="solid"];
    "2" -> "4" [label="DATA(unique_nums)", style="solid"];
    "3" -> "5" [label="DATA(num)", style="solid"];
    "2" -> "5" [label="DATA(unique_nums)", style="solid"];
    "2" -> "6" [label="DATA(unique_nums)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}