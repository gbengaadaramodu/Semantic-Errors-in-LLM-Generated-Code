digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def number_of_substrings(s): | W:s,number_of_substrings", fillcolor="lightgreen"];
    "2" [label="L2: return len([i for i in s if i != \"\"]) | W:i | R:i,len,s", fillcolor="salmon"];

    "1" -> "2" [label="DATA(s)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}