digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def min_sub_array_sum(nums): | W:nums,min_sub_array_sum", fillcolor="lightgreen"];
    "2" [label="L2: return min(sum(nums[i:j]) for i in range(len(nums)) for j in range(i+1, len(nums)+1)) | W:i,j | R:i,j,len,min,nums,range,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(nums)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}