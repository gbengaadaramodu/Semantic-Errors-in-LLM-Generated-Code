digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def largest_prime(lst): | W:lst,largest_prime", fillcolor="lightgreen"];
    "2" [label="L2: prime_numbers = [] | W:prime_numbers", fillcolor="lightgrey"];
    "3" [label="L3: for num in lst: | W:num | R:lst", fillcolor="lightgrey"];
    "4" [label="L4: if is_prime(num): | R:is_prime,num", fillcolor="lightgrey"];
    "5" [label="L5: prime_numbers.append(num) | R:num,prime_numbers", fillcolor="lightgrey"];
    "6" [label="L6: max_prime = max(prime_numbers) | W:max_prime | R:max,prime_numbers", fillcolor="lightgrey"];
    "7" [label="L7: return sum_digits(max_prime) | R:max_prime,sum_digits", fillcolor="lightgrey"];
    "8" [label="L9: def is_prime(n): | W:n,is_prime", fillcolor="lightgreen"];
    "9" [label="L10: if n == 1 or n == 0: | R:n", fillcolor="lightgrey"];
    "10" [label="L11: return False", fillcolor="lightgrey"];
    "11" [label="L12: for i in range(2, int(n ** 0.5) + 1): | W:i | R:int,n,range", fillcolor="lightgrey"];
    "12" [label="L13: if n % i == 0: | R:i,n", fillcolor="lightgrey"];
    "13" [label="L14: return False", fillcolor="lightgrey"];
    "14" [label="L15: return True", fillcolor="lightgrey"];
    "15" [label="L17: def sum_digits(n): | W:n,sum_digits", fillcolor="lightgreen"];
    "16" [label="L18: total = 0 | W:total", fillcolor="lightgrey"];
    "17" [label="L19: while n > 0: | R:n", fillcolor="lightgrey"];
    "18" [label="L20: total += n % 10 | W:total | R:n", fillcolor="lightgrey"];
    "19" [label="L21: n //= 10 | W:n", fillcolor="lightgrey"];
    "20" [label="L22: return total | R:total", fillcolor="salmon"];

    "1" -> "3" [label="DATA(lst)", style="solid"];
    "3" -> "4" [label="DATA(num)", style="solid"];
    "3" -> "5" [label="DATA(num)", style="solid"];
    "2" -> "5" [label="DATA(prime_numbers)", style="solid"];
    "2" -> "6" [label="DATA(prime_numbers)", style="solid"];
    "6" -> "7" [label="DATA(max_prime)", style="solid"];
    "8" -> "9" [label="DATA(n)", style="solid"];
    "8" -> "11" [label="DATA(n)", style="solid"];
    "11" -> "12" [label="DATA(i)", style="solid"];
    "8" -> "12" [label="DATA(n)", style="solid"];
    "15" -> "17" [label="DATA(n)", style="solid"];
    "15" -> "18" [label="DATA(n)", style="solid"];
    "18" -> "20" [label="DATA(total)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
    "8" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
    "9" -> "10" [label="CONTROL(If)", style="dashed"];
    "8" -> "11" [label="CONTROL(FunctionDef)", style="dashed"];
    "11" -> "12" [label="CONTROL(For)", style="dashed"];
    "12" -> "13" [label="CONTROL(If)", style="dashed"];
    "8" -> "14" [label="CONTROL(FunctionDef)", style="dashed"];
    "15" -> "16" [label="CONTROL(FunctionDef)", style="dashed"];
    "15" -> "17" [label="CONTROL(FunctionDef)", style="dashed"];
    "17" -> "18" [label="CONTROL(While)", style="dashed"];
    "17" -> "19" [label="CONTROL(While)", style="dashed"];
    "15" -> "20" [label="CONTROL(FunctionDef)", style="dashed"];
}