digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def file_name_check(file_name): | W:file_name,file_name_check", fillcolor="lightgreen"];
    "2" [label="L2: if len(file_name) > 3 and \".\" in file_name: | R:file_name,len", fillcolor="lightgreen"];
    "3" [label="L3: prefix, suffix = file_name.split(\".\") | W:prefix,suffix | R:file_name", fillcolor="lightgreen"];
    "4" [label="L4: if prefix and prefix[0].isalpha() and suffix in [\"txt\", \"exe\", \"dll\"]: | R:prefix,suffix", fillcolor="lightgreen"];
    "5" [label="L5: return \"Yes\"", fillcolor="lightgreen"];
    "6" [label="L6: return \"No\"", fillcolor="salmon"];

    "1" -> "2" [label="DATA(file_name)", style="solid"];
    "1" -> "3" [label="DATA(file_name)", style="solid"];
    "3" -> "4" [label="DATA(prefix)", style="solid"];
    "3" -> "4" [label="DATA(suffix)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "2" -> "4" [label="CONTROL(If)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}