digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def swap_list(my_list): | W:my_list,swap_list", fillcolor="lightgreen"];
    "2" [label="L2: my_list[0], my_list[-1] = my_list[-1], my_list[0] | R:my_list", fillcolor="lightgrey"];
    "3" [label="L3: return my_list | R:my_list", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "3" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}