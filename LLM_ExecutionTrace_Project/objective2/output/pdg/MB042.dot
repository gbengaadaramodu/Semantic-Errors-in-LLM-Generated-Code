digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def comb_sort(my_list): | W:my_list,comb_sort", fillcolor="lightgreen"];
    "2" [label="L2: gap = len(my_list) | W:gap | R:len,my_list", fillcolor="lightgrey"];
    "3" [label="L3: swapped = True | W:swapped", fillcolor="lightgrey"];
    "4" [label="L4: while gap > 1 or swapped: | R:gap,swapped", fillcolor="lightgrey"];
    "5" [label="L5: gap = int(gap * 10 / 13) | W:gap | R:gap,int", fillcolor="lightgrey"];
    "6" [label="L6: swapped = False | W:swapped", fillcolor="lightgrey"];
    "7" [label="L7: for i in range(len(my_list) - gap): | W:i | R:gap,len,my_list,range", fillcolor="lightgrey"];
    "8" [label="L8: if my_list[i] > my_list[i + gap]: | R:gap,i,my_list", fillcolor="lightgrey"];
    "9" [label="L9: my_list[i], my_list[i + gap] = my_list[i + gap], my_list[i] | R:gap,i,my_list", fillcolor="lightgrey"];
    "10" [label="L10: swapped = True | W:swapped", fillcolor="lightgrey"];
    "11" [label="L11: return my_list | R:my_list", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "2" -> "4" [label="DATA(gap)", style="solid"];
    "3" -> "4" [label="DATA(swapped)", style="solid"];
    "2" -> "5" [label="DATA(gap)", style="solid"];
    "5" -> "7" [label="DATA(gap)", style="solid"];
    "1" -> "7" [label="DATA(my_list)", style="solid"];
    "5" -> "8" [label="DATA(gap)", style="solid"];
    "7" -> "8" [label="DATA(i)", style="solid"];
    "1" -> "8" [label="DATA(my_list)", style="solid"];
    "5" -> "9" [label="DATA(gap)", style="solid"];
    "7" -> "9" [label="DATA(i)", style="solid"];
    "1" -> "9" [label="DATA(my_list)", style="solid"];
    "1" -> "11" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(While)", style="dashed"];
    "4" -> "6" [label="CONTROL(While)", style="dashed"];
    "4" -> "7" [label="CONTROL(While)", style="dashed"];
    "7" -> "8" [label="CONTROL(For)", style="dashed"];
    "8" -> "9" [label="CONTROL(If)", style="dashed"];
    "8" -> "10" [label="CONTROL(If)", style="dashed"];
    "1" -> "11" [label="CONTROL(FunctionDef)", style="dashed"];
}