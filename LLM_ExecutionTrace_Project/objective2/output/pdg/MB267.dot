digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def polar_rect(r, theta): | W:r,theta,polar_rect", fillcolor="lightgreen"];
    "2" [label="L2: x = r * math.cos(theta) | W:x | R:math,r,theta", fillcolor="salmon"];
    "3" [label="L3: y = r * math.sin(theta) | W:y | R:math,r,theta", fillcolor="lightgrey"];
    "4" [label="L4: return (x, y) | R:x,y", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(r)", style="solid"];
    "1" -> "2" [label="DATA(theta)", style="solid"];
    "1" -> "3" [label="DATA(r)", style="solid"];
    "1" -> "3" [label="DATA(theta)", style="solid"];
    "2" -> "4" [label="DATA(x)", style="solid"];
    "3" -> "4" [label="DATA(y)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
}