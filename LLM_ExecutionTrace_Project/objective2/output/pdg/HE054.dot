digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def f(n): | W:n,f", fillcolor="lightgreen"];
    "2" [label="L2: return [factorial(i) if i % 2 == 0 else sum(range(1, i + 1)) for i in range(1, n + 1)] | W:i | R:factorial,i,n,range,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}