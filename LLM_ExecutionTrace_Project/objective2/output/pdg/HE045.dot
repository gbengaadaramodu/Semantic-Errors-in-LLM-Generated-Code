digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def intersperse(numbers: List[int], delimeter: int) -> List[int]: | W:delimeter,numbers,intersperse | R:List,int", fillcolor="salmon"];
    "2" [label="L2: return [delimeter].join(map(str, numbers)).split(str(delimeter)) | R:delimeter,map,numbers,str", fillcolor="salmon"];

    "1" -> "2" [label="DATA(delimeter)", style="solid"];
    "1" -> "2" [label="DATA(numbers)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}