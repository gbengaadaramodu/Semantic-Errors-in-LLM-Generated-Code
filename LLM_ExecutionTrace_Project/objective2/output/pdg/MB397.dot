digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def max_aggregate(my_list): | W:my_list,max_aggregate", fillcolor="lightgreen"];
    "2" [label="L2: return max(my_list, key=lambda x: x[1]) | W:x | R:max,my_list,x", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}