digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def remove_occ(string, char): | W:char,string,remove_occ", fillcolor="lightgreen"];
    "2" [label="L2: return string.replace(char, \"\", 1).replace(char, \"\", 1) | R:char,string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(char)", style="solid"];
    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}