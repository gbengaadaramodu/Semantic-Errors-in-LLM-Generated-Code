digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def get_row(lst, x): | W:lst,x,get_row", fillcolor="lightgreen"];
    "2" [label="L2: result = [] | W:result", fillcolor="lightgreen"];
    "3" [label="L3: for i, row in enumerate(lst): | W:i,row | R:enumerate,lst", fillcolor="lightgreen"];
    "4" [label="L4: if x in row: | R:row,x", fillcolor="lightgreen"];
    "5" [label="L5: result.append((i, row.index(x))) | R:i,result,row,x", fillcolor="lightgreen"];
    "6" [label="L6: return result | R:result", fillcolor="salmon"];

    "1" -> "3" [label="DATA(lst)", style="solid"];
    "3" -> "4" [label="DATA(row)", style="solid"];
    "1" -> "4" [label="DATA(x)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "2" -> "5" [label="DATA(result)", style="solid"];
    "3" -> "5" [label="DATA(row)", style="solid"];
    "1" -> "5" [label="DATA(x)", style="solid"];
    "2" -> "6" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}