digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sum_common_divisors(num1, num2): | W:num1,num2,sum_common_divisors", fillcolor="lightgreen"];
    "2" [label="L2: return sum(set(range(1, num1 + 1)).intersection(range(1, num2 + 1))) | R:num1,num2,range,set,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(num1)", style="solid"];
    "1" -> "2" [label="DATA(num2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}