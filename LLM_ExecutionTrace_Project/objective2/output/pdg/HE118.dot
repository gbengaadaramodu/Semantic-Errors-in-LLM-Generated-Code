digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def get_closest_vowel(word): | W:word,get_closest_vowel", fillcolor="lightgreen"];
    "2" [label="L2: vowels = \"aeiou\" | W:vowels", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(len(word)-1, -1, -1): | W:i | R:len,range,word", fillcolor="lightgreen"];
    "4" [label="L4: if word[i] in vowels: | R:i,vowels,word", fillcolor="lightgreen"];
    "5" [label="L5: return word[i] | R:i,word", fillcolor="lightgreen"];
    "6" [label="L6: return \"\"", fillcolor="salmon"];

    "1" -> "3" [label="DATA(word)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "2" -> "4" [label="DATA(vowels)", style="solid"];
    "1" -> "4" [label="DATA(word)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(word)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}