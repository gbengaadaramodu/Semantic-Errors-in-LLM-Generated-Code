digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def get_inv_count(arr): | W:arr,get_inv_count", fillcolor="lightgreen"];
    "2" [label="L2: inv_count = 0 | W:inv_count", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(len(arr)): | W:i | R:arr,len,range", fillcolor="lightgrey"];
    "4" [label="L4: for j in range(i+1, len(arr)): | W:j | R:arr,i,len,range", fillcolor="lightgrey"];
    "5" [label="L5: if arr[i] > arr[j]: | R:arr,i,j", fillcolor="lightgrey"];
    "6" [label="L6: inv_count += 1 | W:inv_count", fillcolor="lightgrey"];
    "7" [label="L7: return inv_count | R:inv_count", fillcolor="salmon"];

    "1" -> "3" [label="DATA(arr)", style="solid"];
    "1" -> "4" [label="DATA(arr)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(arr)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "4" -> "5" [label="DATA(j)", style="solid"];
    "6" -> "7" [label="DATA(inv_count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}