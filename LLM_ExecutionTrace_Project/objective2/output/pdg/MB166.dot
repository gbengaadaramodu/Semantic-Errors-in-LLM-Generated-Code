digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def divisible_by_digits(startnum, endnum): | W:endnum,startnum,divisible_by_digits", fillcolor="lightgreen"];
    "2" [label="L2: return [num for num in range(startnum, endnum+1) if all(int(digit) for digit in str(num))] | W:digit,num | R:all,digit,endnum,int,num,range,startnum,str", fillcolor="salmon"];

    "1" -> "2" [label="DATA(endnum)", style="solid"];
    "1" -> "2" [label="DATA(startnum)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}