digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def area_polygon(length, num_sides): | W:length,num_sides,area_polygon", fillcolor="lightgreen"];
    "2" [label="L2: return length ** 2 * num_sides / (4 * tan(pi / num_sides)) | R:length,num_sides,pi,tan", fillcolor="salmon"];

    "1" -> "2" [label="DATA(length)", style="solid"];
    "1" -> "2" [label="DATA(num_sides)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}