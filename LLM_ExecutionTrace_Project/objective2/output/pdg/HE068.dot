digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def make_a_pile(n): | W:n,make_a_pile", fillcolor="lightgreen"];
    "2" [label="L2: levels = [] | W:levels", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(n): | W:i | R:n,range", fillcolor="lightgreen"];
    "4" [label="L4: if i % 2 == 0: | R:i", fillcolor="lightgreen"];
    "5" [label="L5: levels.append(i + 1) | R:i,levels", fillcolor="lightgreen"];
    "6" [label="L7: levels.append(i + 2) | R:i,levels", fillcolor="lightgreen"];
    "7" [label="L8: return levels | R:levels", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "2" -> "5" [label="DATA(levels)", style="solid"];
    "3" -> "6" [label="DATA(i)", style="solid"];
    "2" -> "6" [label="DATA(levels)", style="solid"];
    "2" -> "7" [label="DATA(levels)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "4" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}