digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def Find_Max_Length(my_list): | W:my_list,Find_Max_Length", fillcolor="lightgreen"];
    "2" [label="L2: return max(len(sublist) for sublist in my_list) | W:sublist | R:len,max,my_list,sublist", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}