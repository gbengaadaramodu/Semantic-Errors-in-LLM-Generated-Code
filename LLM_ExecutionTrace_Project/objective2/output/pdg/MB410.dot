digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def positive_count(arr): | W:arr,positive_count", fillcolor="lightgreen"];
    "2" [label="L2: count = 0 | W:count", fillcolor="lightgreen"];
    "3" [label="L3: for num in arr: | W:num | R:arr", fillcolor="lightgreen"];
    "4" [label="L4: if num > 0: | R:num", fillcolor="lightgreen"];
    "5" [label="L5: count += 1 | W:count", fillcolor="lightgreen"];
    "6" [label="L6: return count / len(arr) | R:arr,count,len", fillcolor="salmon"];

    "1" -> "3" [label="DATA(arr)", style="solid"];
    "3" -> "4" [label="DATA(num)", style="solid"];
    "1" -> "6" [label="DATA(arr)", style="solid"];
    "5" -> "6" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}