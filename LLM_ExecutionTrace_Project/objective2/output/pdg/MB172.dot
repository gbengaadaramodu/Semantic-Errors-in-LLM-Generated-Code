digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def maximize_elements(tuple1, tuple2): | W:tuple1,tuple2,maximize_elements", fillcolor="lightgreen"];
    "2" [label="L2: return tuple(max(a, b) for a, b in zip(tuple1, tuple2)) | W:a,b | R:a,b,max,tuple,tuple1,tuple2,zip", fillcolor="salmon"];

    "1" -> "2" [label="DATA(tuple1)", style="solid"];
    "1" -> "2" [label="DATA(tuple2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}