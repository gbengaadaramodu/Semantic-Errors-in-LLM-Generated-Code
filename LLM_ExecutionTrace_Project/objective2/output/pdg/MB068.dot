digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def get_coordinates(coordinate): | W:coordinate,get_coordinates", fillcolor="salmon"];
    "2" [label="L2: x, y = coordinate | W:x,y | R:coordinate", fillcolor="lightgrey"];
    "3" [label="L3: return [[x-1, y-1], [x-1, y], [x-1, y+1],             [x,   y-1],           [x,   y+1],             [x+1, y-1], [x+1, y], [x+1, y+1]] | R:x,y", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(coordinate)", style="solid"];
    "2" -> "3" [label="DATA(x)", style="solid"];
    "2" -> "3" [label="DATA(y)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}