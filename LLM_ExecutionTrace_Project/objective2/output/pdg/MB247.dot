digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def max_product_tuple(tuples): | W:tuples,max_product_tuple", fillcolor="lightgreen"];
    "2" [label="L2: max_product = 0 | W:max_product", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(len(tuples)): | W:i | R:len,range,tuples", fillcolor="lightgreen"];
    "4" [label="L4: for j in range(i+1, len(tuples)): | W:j | R:i,len,range,tuples", fillcolor="lightgreen"];
    "5" [label="L5: product = abs(tuples[i][0] * tuples[j][1]) + abs(tuples[i][1] * tuples[j][0]) | W:product | R:abs,i,j,tuples", fillcolor="lightgreen"];
    "6" [label="L6: if product > max_product: | R:max_product,product", fillcolor="lightgreen"];
    "7" [label="L7: max_product = product | W:max_product | R:product", fillcolor="lightgreen"];
    "8" [label="L8: return max_product | R:max_product", fillcolor="salmon"];

    "1" -> "3" [label="DATA(tuples)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "4" [label="DATA(tuples)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "4" -> "5" [label="DATA(j)", style="solid"];
    "1" -> "5" [label="DATA(tuples)", style="solid"];
    "2" -> "6" [label="DATA(max_product)", style="solid"];
    "5" -> "6" [label="DATA(product)", style="solid"];
    "5" -> "7" [label="DATA(product)", style="solid"];
    "7" -> "8" [label="DATA(max_product)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "4" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
}