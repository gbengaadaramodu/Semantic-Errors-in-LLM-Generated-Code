digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def text_match_three(s): | W:s,text_match_three", fillcolor="lightgreen"];
    "2" [label="L2: return re.search(r'a{3}', s) is not None | R:re,s", fillcolor="salmon"];

    "1" -> "2" [label="DATA(s)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}