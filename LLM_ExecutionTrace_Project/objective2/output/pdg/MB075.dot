digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def check_occurences(my_list): | W:my_list,check_occurences", fillcolor="lightgreen"];
    "2" [label="L2: occurences = {} | W:occurences", fillcolor="lightgrey"];
    "3" [label="L3: for tup in my_list: | W:tup | R:my_list", fillcolor="lightgrey"];
    "4" [label="L4: if tup in occurences: | R:occurences,tup", fillcolor="lightgrey"];
    "5" [label="L5: occurences[tup] += 1 | R:occurences,tup", fillcolor="lightgrey"];
    "6" [label="L7: occurences[tup] = 1 | R:occurences,tup", fillcolor="lightgrey"];
    "7" [label="L8: return occurences | R:occurences", fillcolor="salmon"];

    "1" -> "3" [label="DATA(my_list)", style="solid"];
    "2" -> "4" [label="DATA(occurences)", style="solid"];
    "3" -> "4" [label="DATA(tup)", style="solid"];
    "2" -> "5" [label="DATA(occurences)", style="solid"];
    "3" -> "5" [label="DATA(tup)", style="solid"];
    "2" -> "6" [label="DATA(occurences)", style="solid"];
    "3" -> "6" [label="DATA(tup)", style="solid"];
    "2" -> "7" [label="DATA(occurences)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "4" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}