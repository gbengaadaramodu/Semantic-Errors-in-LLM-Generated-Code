digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def kth_element(arr, k): | W:arr,k,kth_element", fillcolor="lightgreen"];
    "2" [label="L2: return arr[k-1] | R:arr,k", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "2" [label="DATA(k)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}