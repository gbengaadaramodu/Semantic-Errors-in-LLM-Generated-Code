digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def word_len(word): | W:word,word_len", fillcolor="lightgreen"];
    "2" [label="L2: return len(word) % 2 != 0 | R:len,word", fillcolor="salmon"];

    "1" -> "2" [label="DATA(word)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}