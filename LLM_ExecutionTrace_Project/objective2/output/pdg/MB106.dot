digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_even_pair(my_list): | W:my_list,find_even_pair", fillcolor="lightgreen"];
    "2" [label="L2: count = 0 | W:count", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(len(my_list)): | W:i | R:len,my_list,range", fillcolor="lightgrey"];
    "4" [label="L4: for j in range(i+1, len(my_list)): | W:j | R:i,len,my_list,range", fillcolor="lightgrey"];
    "5" [label="L5: if (my_list[i] ^ my_list[j]) % 2 == 0: | R:i,j,my_list", fillcolor="lightgrey"];
    "6" [label="L6: count += 1 | W:count", fillcolor="lightgrey"];
    "7" [label="L7: return count | R:count", fillcolor="salmon"];

    "1" -> "3" [label="DATA(my_list)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "4" [label="DATA(my_list)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "4" -> "5" [label="DATA(j)", style="solid"];
    "1" -> "5" [label="DATA(my_list)", style="solid"];
    "6" -> "7" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}