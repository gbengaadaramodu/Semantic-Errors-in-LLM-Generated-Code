digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_vowels(input_string): | W:input_string,count_vowels", fillcolor="lightgreen"];
    "2" [label="L2: vowels = [\"a\", \"e\", \"i\", \"o\", \"u\"] | W:vowels", fillcolor="lightgreen"];
    "3" [label="L3: count = 0 | W:count", fillcolor="lightgreen"];
    "4" [label="L4: for i in range(len(input_string)): | W:i | R:input_string,len,range", fillcolor="lightgreen"];
    "5" [label="L5: if input_string[i].lower() in vowels: | R:i,input_string,vowels", fillcolor="lightgreen"];
    "6" [label="L6: if i > 0 and input_string[i-1].lower() in vowels: | R:i,input_string,vowels", fillcolor="lightgreen"];
    "7" [label="L7: count += 1 | W:count", fillcolor="lightgreen"];
    "8" [label="L8: if i < len(input_string) - 1 and input_string[i+1].lower() in vowels: | R:i,input_string,len,vowels", fillcolor="lightgreen"];
    "9" [label="L9: count += 1 | W:count", fillcolor="lightgreen"];
    "10" [label="L10: return count | R:count", fillcolor="salmon"];

    "1" -> "4" [label="DATA(input_string)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(input_string)", style="solid"];
    "2" -> "5" [label="DATA(vowels)", style="solid"];
    "4" -> "6" [label="DATA(i)", style="solid"];
    "1" -> "6" [label="DATA(input_string)", style="solid"];
    "2" -> "6" [label="DATA(vowels)", style="solid"];
    "4" -> "8" [label="DATA(i)", style="solid"];
    "1" -> "8" [label="DATA(input_string)", style="solid"];
    "2" -> "8" [label="DATA(vowels)", style="solid"];
    "9" -> "10" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "5" -> "8" [label="CONTROL(If)", style="dashed"];
    "8" -> "9" [label="CONTROL(If)", style="dashed"];
    "1" -> "10" [label="CONTROL(FunctionDef)", style="dashed"];
}