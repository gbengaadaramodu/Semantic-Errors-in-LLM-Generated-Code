digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def check_monthnumb_number(month): | W:month,check_monthnumb_number", fillcolor="lightgreen"];
    "2" [label="L2: return month in [1, 3, 5, 7, 8, 10, 12] | R:month", fillcolor="salmon"];

    "1" -> "2" [label="DATA(month)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}