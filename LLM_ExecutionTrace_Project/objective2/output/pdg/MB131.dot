digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sequence(n): | W:n,sequence", fillcolor="lightgreen"];
    "2" [label="L2: if n <= 2: | R:n", fillcolor="lightgrey"];
    "3" [label="L3: return n | R:n", fillcolor="lightgrey"];
    "4" [label="L5: return sequence(sequence(n-1)) + sequence(n-sequence(n-1)) | R:n,sequence", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "3" [label="DATA(n)", style="solid"];
    "1" -> "4" [label="DATA(n)", style="solid"];
    "1" -> "4" [label="DATA(sequence)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "2" -> "4" [label="CONTROL(If)", style="dashed"];
}