digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def second_smallest(my_list): | W:my_list,second_smallest", fillcolor="lightgreen"];
    "2" [label="L2: sorted_list = sorted(my_list) | W:sorted_list | R:my_list,sorted", fillcolor="lightgreen"];
    "3" [label="L3: return sorted_list[1] | R:sorted_list", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "2" -> "3" [label="DATA(sorted_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}