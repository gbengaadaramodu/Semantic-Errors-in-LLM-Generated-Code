digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def extract_values(string): | W:string,extract_values", fillcolor="lightgreen"];
    "2" [label="L2: return re.findall(r'\"([^\"]*)\"', string) | R:re,string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}