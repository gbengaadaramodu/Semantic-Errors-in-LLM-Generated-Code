digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def dict_depth(my_dict): | W:my_dict,dict_depth", fillcolor="lightgreen"];
    "2" [label="L2: max_depth = 0 | W:max_depth", fillcolor="lightgreen"];
    "3" [label="L3: for key, value in my_dict.items(): | W:key,value | R:my_dict", fillcolor="lightgreen"];
    "4" [label="L4: if isinstance(value, dict): | R:dict,isinstance,value", fillcolor="lightgreen"];
    "5" [label="L5: max_depth = max(max_depth, dict_depth(value) + 1) | W:max_depth | R:dict_depth,max,max_depth,value", fillcolor="lightgreen"];
    "6" [label="L6: return max_depth | R:max_depth", fillcolor="salmon"];

    "1" -> "3" [label="DATA(my_dict)", style="solid"];
    "3" -> "4" [label="DATA(value)", style="solid"];
    "1" -> "5" [label="DATA(dict_depth)", style="solid"];
    "2" -> "5" [label="DATA(max_depth)", style="solid"];
    "3" -> "5" [label="DATA(value)", style="solid"];
    "5" -> "6" [label="DATA(max_depth)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}