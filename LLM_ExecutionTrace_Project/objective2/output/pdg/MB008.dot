digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_first_elements(my_tuple): | W:my_tuple,count_first_elements", fillcolor="lightgreen"];
    "2" [label="L2: count = 0 | W:count", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(len(my_tuple)): | W:i | R:len,my_tuple,range", fillcolor="lightgrey"];
    "4" [label="L4: if my_tuple[i] == (4, 6): | R:i,my_tuple", fillcolor="lightgrey"];
    "5" [label="L5: break", fillcolor="lightgrey"];
    "6" [label="L6: count += 1 | W:count", fillcolor="lightgrey"];
    "7" [label="L7: return count | R:count", fillcolor="salmon"];

    "1" -> "3" [label="DATA(my_tuple)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "4" [label="DATA(my_tuple)", style="solid"];
    "6" -> "7" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "3" -> "6" [label="CONTROL(For)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}