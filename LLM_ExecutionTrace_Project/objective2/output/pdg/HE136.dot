digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def fruit_distribution(s, n): | W:n,s,fruit_distribution", fillcolor="lightgreen"];
    "2" [label="L2: apples, oranges = map(int, s.split()[:2]) | W:apples,oranges | R:int,map,s", fillcolor="salmon"];
    "3" [label="L3: return n - apples - oranges | R:apples,n,oranges", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(s)", style="solid"];
    "2" -> "3" [label="DATA(apples)", style="solid"];
    "1" -> "3" [label="DATA(n)", style="solid"];
    "2" -> "3" [label="DATA(oranges)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}