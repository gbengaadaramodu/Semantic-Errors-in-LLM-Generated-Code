digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def merge(my_list): | W:my_list,merge", fillcolor="lightgreen"];
    "2" [label="L2: return [[sublist[0] for sublist in my_list], [sublist[1] for sublist in my_list]] | W:sublist | R:my_list,sublist", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}