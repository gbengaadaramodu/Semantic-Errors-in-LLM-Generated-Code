digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def decode_shift(s: str): | W:s,decode_shift | R:str", fillcolor="lightgreen"];
    "2" [label="L2: return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s]) | W:ch | R:ch,chr,ord,s", fillcolor="salmon"];

    "1" -> "2" [label="DATA(s)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}