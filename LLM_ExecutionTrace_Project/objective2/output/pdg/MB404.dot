digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def square_sum(n): | W:n,square_sum", fillcolor="lightgreen"];
    "2" [label="L2: return sum([i**2 for i in range(1, n+1, 2)]) | W:i | R:i,n,range,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}