digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def maximum(arr, k): | W:arr,k,maximum", fillcolor="lightgreen"];
    "2" [label="L2: return sorted(arr, reverse=True)[:k] | R:arr,k,sorted", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "2" [label="DATA(k)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}