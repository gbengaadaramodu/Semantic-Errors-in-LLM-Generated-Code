digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sorted_list_sum(lst): | W:lst,sorted_list_sum", fillcolor="lightgreen"];
