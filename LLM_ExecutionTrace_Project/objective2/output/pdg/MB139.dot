digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def replace_spaces(string): | W:string,replace_spaces", fillcolor="lightgreen"];
    "2" [label="L2: return string.replace(\" \", \"_\").replace(\"_\", \" \") | R:string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}