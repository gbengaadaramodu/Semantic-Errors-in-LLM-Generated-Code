digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def even_power_sum(n): | W:n,even_power_sum", fillcolor="lightgreen"];
    "2" [label="L2: sum = 0 | W:sum", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(n): | W:i | R:n,range", fillcolor="lightgrey"];
    "4" [label="L4: sum += (2*i)**5 | W:sum | R:i", fillcolor="lightgrey"];
    "5" [label="L5: return sum | R:sum", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "4" -> "5" [label="DATA(sum)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}