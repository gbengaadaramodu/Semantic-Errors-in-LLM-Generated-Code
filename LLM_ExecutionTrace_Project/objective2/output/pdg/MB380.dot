digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_odd_pair(arr, k): | W:arr,k,find_odd_pair", fillcolor="lightgreen"];
    "2" [label="L2: return sum(1 for i in range(len(arr)) for j in range(i+1, len(arr)) if (arr[i] ^ arr[j]) % k == 0) | W:i,j | R:arr,i,j,k,len,range,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "2" [label="DATA(k)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}