digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def all_bits_set_in_the_given_range(n, start, end): | W:end,n,start,all_bits_set_in_the_given_range", fillcolor="lightgreen"];
    "2" [label="L2: return all(bin(i)[2:].zfill(n) for i in range(start, end+1)) | W:i | R:all,bin,end,i,n,range,start", fillcolor="salmon"];

    "1" -> "2" [label="DATA(end)", style="solid"];
    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="DATA(start)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}