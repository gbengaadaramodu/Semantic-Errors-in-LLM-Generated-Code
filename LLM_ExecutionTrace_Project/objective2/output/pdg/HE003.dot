digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def parse_nested_parens(paren_string: str) -> List[int]: | W:paren_string,parse_nested_parens | R:str", fillcolor="salmon"];
    "2" [label="L2: nesting_levels = [] | W:nesting_levels", fillcolor="lightgrey"];
    "3" [label="L3: for group in paren_string.split(): | W:group | R:paren_string", fillcolor="lightgrey"];
    "4" [label="L4: nesting_level = 0 | W:nesting_level", fillcolor="lightgrey"];
    "5" [label="L5: for char in group: | W:char | R:group", fillcolor="lightgrey"];
    "6" [label="L6: if char == '(': | R:char", fillcolor="lightgrey"];
    "7" [label="L7: nesting_level += 1 | W:nesting_level", fillcolor="lightgrey"];
    "8" [label="L8: elif char == ')': | R:char", fillcolor="lightgrey"];
    "9" [label="L9: nesting_level -= 1 | W:nesting_level", fillcolor="lightgrey"];
    "10" [label="L10: nesting_levels.append(nesting_level) | R:nesting_level,nesting_levels", fillcolor="lightgrey"];
    "11" [label="L11: return nesting_levels | R:nesting_levels", fillcolor="salmon"];

    "1" -> "3" [label="DATA(paren_string)", style="solid"];
    "3" -> "5" [label="DATA(group)", style="solid"];
    "5" -> "6" [label="DATA(char)", style="solid"];
    "5" -> "8" [label="DATA(char)", style="solid"];
    "9" -> "10" [label="DATA(nesting_level)", style="solid"];
    "2" -> "10" [label="DATA(nesting_levels)", style="solid"];
    "2" -> "11" [label="DATA(nesting_levels)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "3" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "6" -> "8" [label="CONTROL(If)", style="dashed"];
    "8" -> "9" [label="CONTROL(If)", style="dashed"];
    "3" -> "10" [label="CONTROL(For)", style="dashed"];
    "1" -> "11" [label="CONTROL(FunctionDef)", style="dashed"];
}