digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def max_Product(arr): | W:arr,max_Product", fillcolor="lightgreen"];
    "2" [label="L2: if len(arr) == 0: | R:arr,len", fillcolor="lightgrey"];
    "3" [label="L3: return None", fillcolor="lightgrey"];
    "4" [label="L4: max_product = arr[0] | W:max_product | R:arr", fillcolor="lightgrey"];
    "5" [label="L5: for i in range(1, len(arr)): | W:i | R:arr,len,range", fillcolor="lightgrey"];
    "6" [label="L6: if arr[i] > max_product: | R:arr,i,max_product", fillcolor="lightgrey"];
    "7" [label="L7: max_product = arr[i] | W:max_product | R:arr,i", fillcolor="lightgrey"];
    "8" [label="L8: return max_product | R:max_product", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "4" [label="DATA(arr)", style="solid"];
    "1" -> "5" [label="DATA(arr)", style="solid"];
    "1" -> "6" [label="DATA(arr)", style="solid"];
    "5" -> "6" [label="DATA(i)", style="solid"];
    "4" -> "6" [label="DATA(max_product)", style="solid"];
    "1" -> "7" [label="DATA(arr)", style="solid"];
    "5" -> "7" [label="DATA(i)", style="solid"];
    "7" -> "8" [label="DATA(max_product)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
    "5" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
}