digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def check_smaller(tuple1, tuple2): | W:tuple1,tuple2,check_smaller", fillcolor="lightgreen"];
    "2" [label="L2: return all(t1 <= t2 for t1, t2 in zip(tuple1, tuple2)) | W:t1,t2 | R:all,t1,t2,tuple1,tuple2,zip", fillcolor="salmon"];

    "1" -> "2" [label="DATA(tuple1)", style="solid"];
    "1" -> "2" [label="DATA(tuple2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}