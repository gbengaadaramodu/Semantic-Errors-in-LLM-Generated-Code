digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_X(my_tuple, element): | W:element,my_tuple,count_X", fillcolor="lightgreen"];
    "2" [label="L2: return my_tuple.count(element) | R:element,my_tuple", fillcolor="salmon"];

    "1" -> "2" [label="DATA(element)", style="solid"];
    "1" -> "2" [label="DATA(my_tuple)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}