digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def parabola_directrix(a, b, c): | W:a,b,c,parabola_directrix", fillcolor="lightgreen"];
    "2" [label="L2: return -b/(2*a) | R:a,b", fillcolor="salmon"];

    "1" -> "2" [label="DATA(a)", style="solid"];
    "1" -> "2" [label="DATA(b)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}