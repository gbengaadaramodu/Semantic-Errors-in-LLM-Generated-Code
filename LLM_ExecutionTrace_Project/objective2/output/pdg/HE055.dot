digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def is_happy(s): | W:s,is_happy", fillcolor="lightgreen"];
    "2" [label="L2: if len(s) < 3: | R:len,s", fillcolor="lightgreen"];
    "3" [label="L3: return False", fillcolor="lightgreen"];
    "4" [label="L4: for i in range(len(s)-2): | W:i | R:len,range,s", fillcolor="lightgreen"];
    "5" [label="L5: if s[i] == s[i+1] and s[i+1] == s[i+2]: | R:i,s", fillcolor="lightgreen"];
    "6" [label="L6: return False", fillcolor="lightgrey"];
    "7" [label="L7: return True", fillcolor="salmon"];

    "1" -> "2" [label="DATA(s)", style="solid"];
    "1" -> "4" [label="DATA(s)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(s)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}