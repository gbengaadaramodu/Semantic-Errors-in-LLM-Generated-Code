digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sumOfFactors(n): | W:n,sumOfFactors", fillcolor="lightgreen"];
    "2" [label="L2: return sum([i for i in range(2, n+1, 2) if n % i == 0]) | W:i | R:i,n,range,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}