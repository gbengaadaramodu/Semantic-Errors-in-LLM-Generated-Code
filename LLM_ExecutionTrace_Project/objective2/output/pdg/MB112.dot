digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def concatenate_tuple(my_tuple): | W:my_tuple,concatenate_tuple", fillcolor="lightgreen"];
    "2" [label="L2: return \"-\".join(map(str, my_tuple)) | R:map,my_tuple,str", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_tuple)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}