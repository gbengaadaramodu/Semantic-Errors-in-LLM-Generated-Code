digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def division_elements(tuple1, tuple2): | W:tuple1,tuple2,division_elements", fillcolor="lightgreen"];
    "2" [label="L2: return tuple(map(lambda x, y: x / y, tuple1, tuple2)) | W:x,y | R:map,tuple,tuple1,tuple2,x,y", fillcolor="salmon"];

    "1" -> "2" [label="DATA(tuple1)", style="solid"];
    "1" -> "2" [label="DATA(tuple2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}