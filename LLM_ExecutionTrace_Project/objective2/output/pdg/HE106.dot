digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def check_if_last_char_is_a_letter(txt): | W:txt,check_if_last_char_is_a_letter", fillcolor="lightgreen"];
    "2" [label="L2: if not txt: | R:txt", fillcolor="lightgreen"];
    "3" [label="L3: return False", fillcolor="lightgrey"];
    "4" [label="L4: if txt[-1].isalpha() and txt[-1] != \" \": | R:txt", fillcolor="lightgreen"];
    "5" [label="L5: return True", fillcolor="lightgreen"];
    "6" [label="L6: return False", fillcolor="salmon"];

    "1" -> "2" [label="DATA(txt)", style="solid"];
    "1" -> "4" [label="DATA(txt)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}