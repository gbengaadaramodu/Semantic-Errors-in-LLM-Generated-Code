digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def max_abs_diff(arr): | W:arr,max_abs_diff", fillcolor="lightgreen"];
    "2" [label="L2: return max([abs(arr[i] - arr[i-1]) for i in range(1, len(arr))]) | W:i | R:abs,arr,i,len,max,range", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}