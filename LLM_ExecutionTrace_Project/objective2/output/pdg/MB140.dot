digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: import math", fillcolor="lightgreen"];
    "2" [label="L3: def circle_circumference(radius): | W:radius,circle_circumference", fillcolor="lightgreen"];
    "3" [label="L4: return 2 * math.pi * radius | R:math,radius", fillcolor="salmon"];

    "2" -> "3" [label="DATA(radius)", style="solid"];
    "2" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}