digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def cycpattern_check(a, b): | W:a,b,cycpattern_check", fillcolor="lightgreen"];
    "2" [label="L2: return any(b in a for _ in range(len(a) - len(b) + 1)) | W:_ | R:a,any,b,len,range", fillcolor="salmon"];

    "1" -> "2" [label="DATA(a)", style="solid"];
    "1" -> "2" [label="DATA(b)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}