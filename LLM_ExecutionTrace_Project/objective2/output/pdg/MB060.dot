digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def shell_sort(arr): | W:arr,shell_sort", fillcolor="lightgreen"];
    "2" [label="L2: gaps = [701, 301, 132, 57, 23, 10, 4, 1] | W:gaps", fillcolor="lightgrey"];
    "3" [label="L3: for gap in gaps: | W:gap | R:gaps", fillcolor="lightgrey"];
    "4" [label="L4: i = gap | W:i | R:gap", fillcolor="lightgrey"];
    "5" [label="L5: while i < len(arr): | R:arr,i,len", fillcolor="lightgrey"];
    "6" [label="L6: temp = arr[i] | W:temp | R:arr,i", fillcolor="lightgrey"];
    "7" [label="L7: j = i | W:j | R:i", fillcolor="lightgrey"];
    "8" [label="L8: while j >= gap and arr[j - gap] > temp: | R:arr,gap,j,temp", fillcolor="lightgrey"];
    "9" [label="L9: arr[j] = arr[j - gap] | R:arr,gap,j", fillcolor="lightgrey"];
    "10" [label="L10: j -= gap | W:j | R:gap", fillcolor="lightgrey"];
    "11" [label="L11: arr[j] = temp | R:arr,j,temp", fillcolor="lightgrey"];
    "12" [label="L12: return arr | R:arr", fillcolor="salmon"];

    "2" -> "3" [label="DATA(gaps)", style="solid"];
    "3" -> "4" [label="DATA(gap)", style="solid"];
    "1" -> "5" [label="DATA(arr)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "6" [label="DATA(arr)", style="solid"];
    "4" -> "6" [label="DATA(i)", style="solid"];
    "4" -> "7" [label="DATA(i)", style="solid"];
    "1" -> "8" [label="DATA(arr)", style="solid"];
    "3" -> "8" [label="DATA(gap)", style="solid"];
    "7" -> "8" [label="DATA(j)", style="solid"];
    "6" -> "8" [label="DATA(temp)", style="solid"];
    "1" -> "9" [label="DATA(arr)", style="solid"];
    "3" -> "9" [label="DATA(gap)", style="solid"];
    "7" -> "9" [label="DATA(j)", style="solid"];
    "3" -> "10" [label="DATA(gap)", style="solid"];
    "1" -> "11" [label="DATA(arr)", style="solid"];
    "10" -> "11" [label="DATA(j)", style="solid"];
    "6" -> "11" [label="DATA(temp)", style="solid"];
    "1" -> "12" [label="DATA(arr)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "3" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(While)", style="dashed"];
    "5" -> "7" [label="CONTROL(While)", style="dashed"];
    "5" -> "8" [label="CONTROL(While)", style="dashed"];
    "8" -> "9" [label="CONTROL(While)", style="dashed"];
    "8" -> "10" [label="CONTROL(While)", style="dashed"];
    "5" -> "11" [label="CONTROL(While)", style="dashed"];
    "1" -> "12" [label="CONTROL(FunctionDef)", style="dashed"];
}