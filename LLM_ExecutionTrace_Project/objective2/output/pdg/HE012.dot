digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_nums(arr): | W:arr,count_nums", fillcolor="lightgreen"];
    "2" [label="L2: return sum(1 for x in arr if x > 0 or (x < 0 and any(int(d) < 0 for d in str(x)))) | W:d,x | R:any,arr,d,int,str,sum,x", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}