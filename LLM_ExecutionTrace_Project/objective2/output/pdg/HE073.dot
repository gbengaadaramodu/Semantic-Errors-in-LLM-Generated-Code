digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def numerical_letter_grade(gpas): | W:gpas,numerical_letter_grade", fillcolor="lightgreen"];
    "2" [label="L3: gpa_to_letter_grade = {         4.0: \"A+\",         3.7: \"A\",         3.3: \"A-\",         3.0: \"B+\",         2.7: \"B\",         2.3: \"B-\",         2.0: \"C+\",         1.7: \"C\",         1.3: \"C-\",         1.0: \"D+\",         0.7: \"D\",         0.0: \"D-\",         0.0: \"E\"     } | W:gpa_to_letter_grade", fillcolor="lightgreen"];
    "3" [label="L20: letter_grades = [] | W:letter_grades", fillcolor="lightgreen"];
    "4" [label="L21: for gpa in gpas: | W:gpa | R:gpas", fillcolor="lightgreen"];
    "5" [label="L22: letter_grade = gpa_to_letter_grade[gpa] | W:letter_grade | R:gpa,gpa_to_letter_grade", fillcolor="salmon"];
    "6" [label="L23: letter_grades.append(letter_grade) | R:letter_grade,letter_grades", fillcolor="lightgreen"];
    "7" [label="L25: return letter_grades | R:letter_grades", fillcolor="lightgrey"];

    "1" -> "4" [label="DATA(gpas)", style="solid"];
    "4" -> "5" [label="DATA(gpa)", style="solid"];
    "2" -> "5" [label="DATA(gpa_to_letter_grade)", style="solid"];
    "5" -> "6" [label="DATA(letter_grade)", style="solid"];
    "3" -> "6" [label="DATA(letter_grades)", style="solid"];
    "3" -> "7" [label="DATA(letter_grades)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "4" -> "6" [label="CONTROL(For)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}