digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def unique_product(my_list): | W:my_list,unique_product", fillcolor="lightgreen"];
    "2" [label="L2: return reduce(lambda x, y: x * y, set(my_list)) | W:x,y | R:my_list,reduce,set,x,y", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}