digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def combinations_colors(my_list, n): | W:my_list,n,combinations_colors", fillcolor="lightgreen"];
    "2" [label="L2: combinations = [] | W:combinations", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(n): | W:i | R:n,range", fillcolor="lightgreen"];
    "4" [label="L4: combinations.append(tuple(my_list)) | R:combinations,my_list,tuple", fillcolor="lightgreen"];
    "5" [label="L5: return combinations | R:combinations", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "2" -> "4" [label="DATA(combinations)", style="solid"];
    "1" -> "4" [label="DATA(my_list)", style="solid"];
    "2" -> "5" [label="DATA(combinations)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}