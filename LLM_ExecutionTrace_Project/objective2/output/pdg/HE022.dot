digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def even_odd_count(num): | W:num,even_odd_count", fillcolor="lightgreen"];
    "2" [label="L2: even_digits = 0 | W:even_digits", fillcolor="lightgreen"];
    "3" [label="L3: odd_digits = 0 | W:odd_digits", fillcolor="lightgreen"];
    "4" [label="L4: while num > 0: | R:num", fillcolor="lightgreen"];
    "5" [label="L5: if num % 10 % 2 == 0: | R:num", fillcolor="lightgreen"];
    "6" [label="L6: even_digits += 1 | W:even_digits", fillcolor="lightgrey"];
    "7" [label="L8: odd_digits += 1 | W:odd_digits", fillcolor="lightgreen"];
    "8" [label="L9: num //= 10 | W:num", fillcolor="lightgreen"];
    "9" [label="L10: return even_digits, odd_digits | R:even_digits,odd_digits", fillcolor="salmon"];

    "1" -> "4" [label="DATA(num)", style="solid"];
    "1" -> "5" [label="DATA(num)", style="solid"];
    "6" -> "9" [label="DATA(even_digits)", style="solid"];
    "7" -> "9" [label="DATA(odd_digits)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(While)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "5" -> "7" [label="CONTROL(If)", style="dashed"];
    "4" -> "8" [label="CONTROL(While)", style="dashed"];
    "1" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
}