digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def odd_num_sum(n): | W:n,odd_num_sum", fillcolor="lightgreen"];
    "2" [label="L2: return sum([x**4 for x in range(1, n*2+1, 2)]) | W:x | R:n,range,sum,x", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}