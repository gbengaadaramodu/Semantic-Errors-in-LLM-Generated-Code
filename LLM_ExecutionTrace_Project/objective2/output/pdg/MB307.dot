digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def extract_rear(my_tuple): | W:my_tuple,extract_rear", fillcolor="lightgreen"];
    "2" [label="L2: return tuple(s[-1] for s in my_tuple) | W:s | R:my_tuple,s,tuple", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_tuple)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}