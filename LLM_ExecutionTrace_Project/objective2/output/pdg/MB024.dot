digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def even_position(my_list): | W:my_list,even_position", fillcolor="lightgreen"];
    "2" [label="L2: return all(my_list[i] % 2 == 0 for i in range(len(my_list)) if i % 2 == 0) | W:i | R:all,i,len,my_list,range", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}