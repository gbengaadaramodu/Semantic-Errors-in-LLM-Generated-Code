digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def insert_element(my_list, element): | W:element,my_list,insert_element", fillcolor="lightgreen"];
    "2" [label="L2: return [element] + my_list | R:element,my_list", fillcolor="salmon"];

    "1" -> "2" [label="DATA(element)", style="solid"];
    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}