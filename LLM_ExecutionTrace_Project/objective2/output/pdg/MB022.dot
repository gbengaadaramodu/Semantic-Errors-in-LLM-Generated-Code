digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sequential_search(arr, element): | W:arr,element,sequential_search", fillcolor="lightgreen"];
    "2" [label="L2: for i in range(len(arr)): | W:i | R:arr,len,range", fillcolor="lightgrey"];
    "3" [label="L3: if arr[i] == element: | R:arr,element,i", fillcolor="lightgrey"];
    "4" [label="L4: return True, i | R:i", fillcolor="lightgrey"];
    "5" [label="L5: return False, -1", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "3" [label="DATA(arr)", style="solid"];
    "1" -> "3" [label="DATA(element)", style="solid"];
    "2" -> "3" [label="DATA(i)", style="solid"];
    "2" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(For)", style="dashed"];
    "3" -> "4" [label="CONTROL(If)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}