digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def start_withp(words): | W:words,start_withp", fillcolor="lightgreen"];
    "2" [label="L2: return tuple(word for word in words if word.startswith(\"p\")) | W:word | R:tuple,word,words", fillcolor="salmon"];

    "1" -> "2" [label="DATA(words)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}