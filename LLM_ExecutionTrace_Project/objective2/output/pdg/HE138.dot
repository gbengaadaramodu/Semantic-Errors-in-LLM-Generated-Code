digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def is_simple_power(x, n): | W:n,x,is_simple_power", fillcolor="lightgreen"];
    "2" [label="L2: return x == n**int(x**0.5)**2 | R:int,n,x", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="DATA(x)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}