digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def minimum(a, b): | W:a,b,minimum", fillcolor="lightgreen"];
    "2" [label="L2: return min(a, b) | R:a,b,min", fillcolor="salmon"];

    "1" -> "2" [label="DATA(a)", style="solid"];
    "1" -> "2" [label="DATA(b)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}