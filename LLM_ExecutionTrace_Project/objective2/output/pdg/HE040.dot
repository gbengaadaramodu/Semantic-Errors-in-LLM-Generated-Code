digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def can_arrange(arr): | W:arr,can_arrange", fillcolor="lightgreen"];
    "2" [label="L2: for i in range(len(arr)-1): | W:i | R:arr,len,range", fillcolor="lightgreen"];
    "3" [label="L3: if arr[i+1] < arr[i]: | R:arr,i", fillcolor="lightgreen"];
    "4" [label="L4: return i | R:i", fillcolor="lightgreen"];
    "5" [label="L5: return -1", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "3" [label="DATA(arr)", style="solid"];
    "2" -> "3" [label="DATA(i)", style="solid"];
    "2" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(For)", style="dashed"];
    "3" -> "4" [label="CONTROL(If)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}