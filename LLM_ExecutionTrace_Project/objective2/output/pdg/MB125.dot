digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def amicable_numbers_sum(n): | W:n,amicable_numbers_sum", fillcolor="lightgreen"];
    "2" [label="L2: sum = 0 | W:sum", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(1, n+1): | W:i | R:n,range", fillcolor="lightgrey"];
    "4" [label="L4: if is_amicable(i): | R:i,is_amicable", fillcolor="lightgrey"];
    "5" [label="L5: sum += i | W:sum | R:i", fillcolor="lightgrey"];
    "6" [label="L6: return sum | R:sum", fillcolor="lightgrey"];
    "7" [label="L8: def is_amicable(n): | W:n,is_amicable", fillcolor="lightgreen"];
    "8" [label="L9: s = sum_proper_divisors(n) | W:s | R:n,sum_proper_divisors", fillcolor="lightgrey"];
    "9" [label="L10: return s != n and s == sum_proper_divisors(s) | R:n,s,sum_proper_divisors", fillcolor="lightgrey"];
    "10" [label="L12: def sum_proper_divisors(n): | W:n,sum_proper_divisors", fillcolor="lightgreen"];
    "11" [label="L13: sum = 0 | W:sum", fillcolor="lightgrey"];
    "12" [label="L14: for i in range(1, int(n**0.5) + 1): | W:i | R:int,n,range", fillcolor="lightgrey"];
    "13" [label="L15: if n % i == 0: | R:i,n", fillcolor="lightgrey"];
    "14" [label="L16: sum += i | W:sum | R:i", fillcolor="lightgrey"];
    "15" [label="L17: if n // i != i: | R:i,n", fillcolor="lightgrey"];
    "16" [label="L18: sum += n // i | W:sum | R:i,n", fillcolor="lightgrey"];
    "17" [label="L19: return sum | R:sum", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "5" -> "6" [label="DATA(sum)", style="solid"];
    "7" -> "8" [label="DATA(n)", style="solid"];
    "7" -> "9" [label="DATA(n)", style="solid"];
    "8" -> "9" [label="DATA(s)", style="solid"];
    "10" -> "12" [label="DATA(n)", style="solid"];
    "12" -> "13" [label="DATA(i)", style="solid"];
    "10" -> "13" [label="DATA(n)", style="solid"];
    "12" -> "14" [label="DATA(i)", style="solid"];
    "12" -> "15" [label="DATA(i)", style="solid"];
    "10" -> "15" [label="DATA(n)", style="solid"];
    "12" -> "16" [label="DATA(i)", style="solid"];
    "10" -> "16" [label="DATA(n)", style="solid"];
    "16" -> "17" [label="DATA(sum)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
    "7" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
    "7" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
    "10" -> "11" [label="CONTROL(FunctionDef)", style="dashed"];
    "10" -> "12" [label="CONTROL(FunctionDef)", style="dashed"];
    "12" -> "13" [label="CONTROL(For)", style="dashed"];
    "13" -> "14" [label="CONTROL(If)", style="dashed"];
    "13" -> "15" [label="CONTROL(If)", style="dashed"];
    "15" -> "16" [label="CONTROL(If)", style="dashed"];
    "10" -> "17" [label="CONTROL(FunctionDef)", style="dashed"];
}