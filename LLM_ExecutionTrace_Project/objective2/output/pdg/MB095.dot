digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def ascii_value(char): | W:char,ascii_value", fillcolor="lightgreen"];
    "2" [label="L2: return ord(char) | R:char,ord", fillcolor="salmon"];

    "1" -> "2" [label="DATA(char)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}