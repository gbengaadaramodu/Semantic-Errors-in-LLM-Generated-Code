digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def histogram(test): | W:test,histogram", fillcolor="lightgreen"];
    "2" [label="L2: hist = {} | W:hist", fillcolor="lightgreen"];
    "3" [label="L3: for char in test: | W:char | R:test", fillcolor="lightgreen"];
    "4" [label="L4: if char not in hist: | R:char,hist", fillcolor="lightgreen"];
    "5" [label="L5: hist[char] = 1 | R:char,hist", fillcolor="lightgreen"];
    "6" [label="L7: hist[char] += 1 | R:char,hist", fillcolor="lightgreen"];
    "7" [label="L8: return hist | R:hist", fillcolor="salmon"];

    "1" -> "3" [label="DATA(test)", style="solid"];
    "3" -> "4" [label="DATA(char)", style="solid"];
    "2" -> "4" [label="DATA(hist)", style="solid"];
    "3" -> "5" [label="DATA(char)", style="solid"];
    "2" -> "5" [label="DATA(hist)", style="solid"];
    "3" -> "6" [label="DATA(char)", style="solid"];
    "2" -> "6" [label="DATA(hist)", style="solid"];
    "2" -> "7" [label="DATA(hist)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "4" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}