digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def even_binomial_coeff_sum(n): | W:n,even_binomial_coeff_sum", fillcolor="lightgreen"];
    "2" [label="L2: result = 0 | W:result", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(n+1): | W:i | R:n,range", fillcolor="lightgrey"];
    "4" [label="L4: if i % 2 == 0: | R:i", fillcolor="lightgrey"];
    "5" [label="L5: result += binomial_coefficient(n, i) | W:result | R:binomial_coefficient,i,n", fillcolor="lightgrey"];
    "6" [label="L6: return result | R:result", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "5" -> "6" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}