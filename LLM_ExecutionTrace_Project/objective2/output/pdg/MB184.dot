digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def consecutive_duplicates(my_list): | W:my_list,consecutive_duplicates", fillcolor="lightgreen"];
    "2" [label="L2: return list(dict.fromkeys(my_list)) | R:dict,list,my_list", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}