digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def lps(s): | W:s,lps", fillcolor="lightgreen"];
    "2" [label="L3: dp = [[0 for x in range(len(s) + 1)] for y in range(len(s) + 1)] | W:dp,x,y | R:len,range,s", fillcolor="lightgrey"];
    "3" [label="L6: for i in range(1, len(s) + 1): | W:i | R:len,range,s", fillcolor="lightgrey"];
    "4" [label="L7: dp[i][0] = 1 | R:dp,i", fillcolor="lightgrey"];
    "5" [label="L8: for j in range(1, len(s) + 1): | W:j | R:len,range,s", fillcolor="lightgrey"];
    "6" [label="L9: dp[0][j] = 1 | R:dp,j", fillcolor="lightgrey"];
    "7" [label="L12: for i in range(1, len(s) + 1): | W:i | R:len,range,s", fillcolor="lightgrey"];
    "8" [label="L13: for j in range(1, len(s) + 1): | W:j | R:len,range,s", fillcolor="lightgrey"];
    "9" [label="L14: if s[i - 1] == s[j - 1]: | R:i,j,s", fillcolor="lightgrey"];
    "10" [label="L15: dp[i][j] = dp[i - 1][j - 1] + 1 | R:dp,i,j", fillcolor="lightgrey"];
    "11" [label="L17: dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]) | R:dp,i,j,max", fillcolor="lightgrey"];
    "12" [label="L20: return dp[len(s)][len(s)] | R:dp,len,s", fillcolor="salmon"];

    "1" -> "2" [label="DATA(s)", style="solid"];
    "1" -> "3" [label="DATA(s)", style="solid"];
    "2" -> "4" [label="DATA(dp)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(s)", style="solid"];
    "2" -> "6" [label="DATA(dp)", style="solid"];
    "5" -> "6" [label="DATA(j)", style="solid"];
    "1" -> "7" [label="DATA(s)", style="solid"];
    "1" -> "8" [label="DATA(s)", style="solid"];
    "7" -> "9" [label="DATA(i)", style="solid"];
    "8" -> "9" [label="DATA(j)", style="solid"];
    "1" -> "9" [label="DATA(s)", style="solid"];
    "2" -> "10" [label="DATA(dp)", style="solid"];
    "7" -> "10" [label="DATA(i)", style="solid"];
    "8" -> "10" [label="DATA(j)", style="solid"];
    "2" -> "11" [label="DATA(dp)", style="solid"];
    "7" -> "11" [label="DATA(i)", style="solid"];
    "8" -> "11" [label="DATA(j)", style="solid"];
    "2" -> "12" [label="DATA(dp)", style="solid"];
    "1" -> "12" [label="DATA(s)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
    "5" -> "6" [label="CONTROL(For)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
    "7" -> "8" [label="CONTROL(For)", style="dashed"];
    "8" -> "9" [label="CONTROL(For)", style="dashed"];
    "9" -> "10" [label="CONTROL(If)", style="dashed"];
    "9" -> "11" [label="CONTROL(If)", style="dashed"];
    "1" -> "12" [label="CONTROL(FunctionDef)", style="dashed"];
}