digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_substrings(s): | W:s,count_substrings", fillcolor="lightgreen"];
    "2" [label="L2: count = 0 | W:count", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(len(s)): | W:i | R:len,range,s", fillcolor="lightgrey"];
    "4" [label="L4: for j in range(i+1, len(s)+1): | W:j | R:i,len,range,s", fillcolor="lightgrey"];
    "5" [label="L5: if sum(int(x) for x in s[i:j]) == j-i: | W:x | R:i,int,j,s,sum,x", fillcolor="lightgrey"];
    "6" [label="L6: count += 1 | W:count", fillcolor="lightgrey"];
    "7" [label="L7: return count | R:count", fillcolor="salmon"];

    "1" -> "3" [label="DATA(s)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "4" [label="DATA(s)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "4" -> "5" [label="DATA(j)", style="solid"];
    "1" -> "5" [label="DATA(s)", style="solid"];
    "6" -> "7" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}