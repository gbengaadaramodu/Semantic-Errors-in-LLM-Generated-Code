digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def power_base_sum(base, power): | W:base,power,power_base_sum", fillcolor="lightgreen"];
    "2" [label="L2: return sum([int(digit) for digit in str(base**power)]) | W:digit | R:base,digit,int,power,str,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(base)", style="solid"];
    "1" -> "2" [label="DATA(power)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}