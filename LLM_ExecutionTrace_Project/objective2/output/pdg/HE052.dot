digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def do_algebra(operator, operand): | W:operand,operator,do_algebra", fillcolor="salmon"];
    "2" [label="L2: result = eval(\" \".join(map(str, operand))) | W:result | R:eval,map,operand,str", fillcolor="salmon"];
    "3" [label="L3: return result | R:result", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(operand)", style="solid"];
    "2" -> "3" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}