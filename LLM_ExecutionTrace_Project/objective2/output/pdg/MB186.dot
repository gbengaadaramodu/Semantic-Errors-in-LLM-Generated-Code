digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def extract_strings(my_list, size): | W:my_list,size,extract_strings", fillcolor="lightgreen"];
    "2" [label="L2: return [my_list[i] for i in range(size)] | W:i | R:i,my_list,range,size", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="DATA(size)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}