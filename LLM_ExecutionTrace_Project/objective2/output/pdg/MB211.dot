digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def highest_power_of_2(n): | W:n,highest_power_of_2", fillcolor="lightgreen"];
    "2" [label="L2: if n <= 1: | R:n", fillcolor="lightgrey"];
    "3" [label="L3: return n | R:n", fillcolor="lightgrey"];
    "4" [label="L5: power = 1 | W:power", fillcolor="lightgrey"];
    "5" [label="L6: while power < n: | R:n,power", fillcolor="lightgrey"];
    "6" [label="L7: power *= 2 | W:power", fillcolor="lightgrey"];
    "7" [label="L9: return power // 2 | R:power", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "3" [label="DATA(n)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "4" -> "5" [label="DATA(power)", style="solid"];
    "6" -> "7" [label="DATA(power)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
    "5" -> "6" [label="CONTROL(While)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}