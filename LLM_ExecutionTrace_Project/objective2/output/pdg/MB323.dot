digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_average_of_cube(n): | W:n,find_average_of_cube", fillcolor="lightgreen"];
    "2" [label="L2: total = 0 | W:total", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(1, n+1): | W:i | R:n,range", fillcolor="lightgrey"];
    "4" [label="L4: total += i**3 | W:total | R:i", fillcolor="lightgrey"];
    "5" [label="L5: return total / n | R:n,total", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "4" -> "5" [label="DATA(total)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}