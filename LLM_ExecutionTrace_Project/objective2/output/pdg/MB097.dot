digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def re_arrange_array(arr, n): | W:arr,n,re_arrange_array", fillcolor="lightgreen"];
    "2" [label="L2: negative_elements = [] | W:negative_elements", fillcolor="lightgrey"];
    "3" [label="L3: positive_elements = [] | W:positive_elements", fillcolor="lightgrey"];
    "4" [label="L4: for i in range(n): | W:i | R:n,range", fillcolor="lightgrey"];
    "5" [label="L5: if arr[i] < 0: | R:arr,i", fillcolor="lightgrey"];
    "6" [label="L6: negative_elements.append(arr[i]) | R:arr,i,negative_elements", fillcolor="lightgrey"];
    "7" [label="L8: positive_elements.append(arr[i]) | R:arr,i,positive_elements", fillcolor="lightgrey"];
    "8" [label="L9: return negative_elements + positive_elements | R:negative_elements,positive_elements", fillcolor="salmon"];

    "1" -> "4" [label="DATA(n)", style="solid"];
    "1" -> "5" [label="DATA(arr)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "6" [label="DATA(arr)", style="solid"];
    "4" -> "6" [label="DATA(i)", style="solid"];
    "2" -> "6" [label="DATA(negative_elements)", style="solid"];
    "1" -> "7" [label="DATA(arr)", style="solid"];
    "4" -> "7" [label="DATA(i)", style="solid"];
    "3" -> "7" [label="DATA(positive_elements)", style="solid"];
    "2" -> "8" [label="DATA(negative_elements)", style="solid"];
    "3" -> "8" [label="DATA(positive_elements)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "5" -> "7" [label="CONTROL(If)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
}