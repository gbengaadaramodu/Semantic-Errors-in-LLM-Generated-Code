digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def get_total_number_of_sequences(m, n): | W:m,n,get_total_number_of_sequences", fillcolor="lightgreen"];
    "2" [label="L2: if n == 1: | R:n", fillcolor="lightgrey"];
    "3" [label="L3: return m | R:m", fillcolor="lightgrey"];
    "4" [label="L4: if n == 2: | R:n", fillcolor="lightgrey"];
    "5" [label="L5: return (m * (m - 1)) // 2 | R:m", fillcolor="lightgrey"];
    "6" [label="L6: if n == 3: | R:n", fillcolor="lightgrey"];
    "7" [label="L7: return (m * (m - 1) * (m - 2)) // 6 | R:m", fillcolor="lightgrey"];
    "8" [label="L8: if n == 4: | R:n", fillcolor="lightgrey"];
    "9" [label="L9: return (m * (m - 1) * (m - 2) * (m - 3)) // 24 | R:m", fillcolor="lightgrey"];
    "10" [label="L10: return 0", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "3" [label="DATA(m)", style="solid"];
    "1" -> "4" [label="DATA(n)", style="solid"];
    "1" -> "5" [label="DATA(m)", style="solid"];
    "1" -> "6" [label="DATA(n)", style="solid"];
    "1" -> "7" [label="DATA(m)", style="solid"];
    "1" -> "8" [label="DATA(n)", style="solid"];
    "1" -> "9" [label="DATA(m)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
    "8" -> "9" [label="CONTROL(If)", style="dashed"];
    "1" -> "10" [label="CONTROL(FunctionDef)", style="dashed"];
}