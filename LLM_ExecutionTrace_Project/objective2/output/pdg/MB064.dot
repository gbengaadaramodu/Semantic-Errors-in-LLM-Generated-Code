digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_occurance(input_string): | W:input_string,count_occurance", fillcolor="lightgreen"];
    "2" [label="L2: return input_string.count(\"std\") | R:input_string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(input_string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}