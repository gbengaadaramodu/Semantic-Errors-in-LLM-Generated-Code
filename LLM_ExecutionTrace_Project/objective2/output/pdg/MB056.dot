digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def is_sum_of_powers_of_two(n): | W:n,is_sum_of_powers_of_two", fillcolor="lightgreen"];
    "2" [label="L2: while n > 0: | R:n", fillcolor="lightgrey"];
    "3" [label="L3: if n == 1: | R:n", fillcolor="lightgrey"];
    "4" [label="L4: return True", fillcolor="lightgrey"];
    "5" [label="L5: elif n % 2 != 0: | R:n", fillcolor="lightgrey"];
    "6" [label="L6: return False", fillcolor="lightgrey"];
    "7" [label="L7: n //= 2 | W:n", fillcolor="lightgrey"];
    "8" [label="L8: return False", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "3" [label="DATA(n)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(While)", style="dashed"];
    "3" -> "4" [label="CONTROL(If)", style="dashed"];
    "3" -> "5" [label="CONTROL(If)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "2" -> "7" [label="CONTROL(While)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
}