digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_min_diff(arr, n): | W:arr,n,find_min_diff", fillcolor="lightgreen"];
    "2" [label="L2: arr.sort() | R:arr", fillcolor="salmon"];
    "3" [label="L3: min_diff = float(\"inf\") | W:min_diff | R:float", fillcolor="lightgrey"];
    "4" [label="L4: for i in range(n-1): | W:i | R:n,range", fillcolor="lightgrey"];
    "5" [label="L5: diff = arr[i+1] - arr[i] | W:diff | R:arr,i", fillcolor="lightgrey"];
    "6" [label="L6: if diff < min_diff: | R:diff,min_diff", fillcolor="lightgrey"];
    "7" [label="L7: min_diff = diff | W:min_diff | R:diff", fillcolor="lightgrey"];
    "8" [label="L8: return min_diff | R:min_diff", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "1" -> "4" [label="DATA(n)", style="solid"];
    "1" -> "5" [label="DATA(arr)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "5" -> "6" [label="DATA(diff)", style="solid"];
    "3" -> "6" [label="DATA(min_diff)", style="solid"];
    "5" -> "7" [label="DATA(diff)", style="solid"];
    "7" -> "8" [label="DATA(min_diff)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "4" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
}