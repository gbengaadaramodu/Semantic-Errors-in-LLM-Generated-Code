digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def min_jumps(point, length): | W:length,point,min_jumps", fillcolor="lightgreen"];
    "2" [label="L2: x, y = point | W:x,y | R:point", fillcolor="lightgrey"];
    "3" [label="L3: if x == length and y == 0: | R:length,x,y", fillcolor="lightgrey"];
    "4" [label="L4: return 1", fillcolor="lightgrey"];
    "5" [label="L5: elif x > length or y > 0: | R:length,x,y", fillcolor="lightgrey"];
    "6" [label="L6: return -1", fillcolor="lightgrey"];
    "7" [label="L8: return 1 + min_jumps((x+1, y), length) | R:length,min_jumps,x,y", fillcolor="salmon"];

    "1" -> "2" [label="DATA(point)", style="solid"];
    "1" -> "3" [label="DATA(length)", style="solid"];
    "2" -> "3" [label="DATA(x)", style="solid"];
    "2" -> "3" [label="DATA(y)", style="solid"];
    "1" -> "5" [label="DATA(length)", style="solid"];
    "2" -> "5" [label="DATA(x)", style="solid"];
    "2" -> "5" [label="DATA(y)", style="solid"];
    "1" -> "7" [label="DATA(length)", style="solid"];
    "1" -> "7" [label="DATA(min_jumps)", style="solid"];
    "2" -> "7" [label="DATA(x)", style="solid"];
    "2" -> "7" [label="DATA(y)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(If)", style="dashed"];
    "3" -> "5" [label="CONTROL(If)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "5" -> "7" [label="CONTROL(If)", style="dashed"];
}