digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def digits(n): | W:n,digits", fillcolor="lightgreen"];
    "2" [label="L2: product = 1 | W:product", fillcolor="lightgreen"];
    "3" [label="L3: for digit in str(n): | W:digit | R:n,str", fillcolor="lightgreen"];
    "4" [label="L4: if digit.isdigit() and int(digit) % 2 != 0: | R:digit,int", fillcolor="lightgreen"];
    "5" [label="L5: product *= int(digit) | W:product | R:digit,int", fillcolor="lightgreen"];
    "6" [label="L6: return product | R:product", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "3" -> "4" [label="DATA(digit)", style="solid"];
    "3" -> "5" [label="DATA(digit)", style="solid"];
    "5" -> "6" [label="DATA(product)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}