digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def fix_spaces(text): | W:text,fix_spaces", fillcolor="lightgreen"];
    "2" [label="L2: return text.replace(\" \", \"_\").replace(\"  \", \"-\") | R:text", fillcolor="salmon"];

    "1" -> "2" [label="DATA(text)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}