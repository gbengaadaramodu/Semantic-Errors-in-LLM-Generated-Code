digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def set_left_most_unset_bit(n): | W:n,set_left_most_unset_bit", fillcolor="lightgreen"];
    "2" [label="L2: return n | (n + 1) | R:n", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}