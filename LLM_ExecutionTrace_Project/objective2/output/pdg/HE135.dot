digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def eat(number, need, remaining): | W:need,number,remaining,eat", fillcolor="lightgreen"];
    "2" [label="L2: return [number + need, max(remaining - need, 0)] | R:max,need,number,remaining", fillcolor="salmon"];

    "1" -> "2" [label="DATA(need)", style="solid"];
    "1" -> "2" [label="DATA(number)", style="solid"];
    "1" -> "2" [label="DATA(remaining)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}