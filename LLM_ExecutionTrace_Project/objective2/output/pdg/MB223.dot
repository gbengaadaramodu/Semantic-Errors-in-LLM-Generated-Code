digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def lcs_of_three(str1, str2, str3): | W:str1,str2,str3,lcs_of_three", fillcolor="lightgreen"];
    "2" [label="L2: m = len(str1) | W:m | R:len,str1", fillcolor="lightgreen"];
    "3" [label="L3: n = len(str2) | W:n | R:len,str2", fillcolor="lightgreen"];
    "4" [label="L4: o = len(str3) | W:o | R:len,str3", fillcolor="lightgreen"];
    "5" [label="L5: dp = [[0] * (n + 1) for _ in range(m + 1)] | W:_,dp | R:m,n,range", fillcolor="lightgreen"];
    "6" [label="L6: for i in range(1, m + 1): | W:i | R:m,range", fillcolor="lightgreen"];
    "7" [label="L7: for j in range(1, n + 1): | W:j | R:n,range", fillcolor="lightgreen"];
    "8" [label="L8: if str1[i - 1] == str2[j - 1]: | R:i,j,str1,str2", fillcolor="lightgreen"];
    "9" [label="L9: dp[i][j] = dp[i - 1][j - 1] + 1 | R:dp,i,j", fillcolor="lightgreen"];
    "10" [label="L11: dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]) | R:dp,i,j,max", fillcolor="lightgreen"];
    "11" [label="L12: for i in range(m + 1): | W:i | R:m,range", fillcolor="lightgreen"];
    "12" [label="L13: for j in range(n + 1): | W:j | R:n,range", fillcolor="lightgreen"];
    "13" [label="L14: if str2[j - 1] == str3[i - 1]: | R:i,j,str2,str3", fillcolor="salmon"];
    "14" [label="L15: dp[i][j] = max(dp[i][j], dp[i - 1][j - 1] + 1) | R:dp,i,j,max", fillcolor="lightgreen"];
    "15" [label="L16: return dp[m][n] | R:dp,m,n", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(str1)", style="solid"];
    "1" -> "3" [label="DATA(str2)", style="solid"];
    "1" -> "4" [label="DATA(str3)", style="solid"];
    "2" -> "5" [label="DATA(m)", style="solid"];
    "3" -> "5" [label="DATA(n)", style="solid"];
    "2" -> "6" [label="DATA(m)", style="solid"];
    "3" -> "7" [label="DATA(n)", style="solid"];
    "6" -> "8" [label="DATA(i)", style="solid"];
    "7" -> "8" [label="DATA(j)", style="solid"];
    "1" -> "8" [label="DATA(str1)", style="solid"];
    "1" -> "8" [label="DATA(str2)", style="solid"];
    "5" -> "9" [label="DATA(dp)", style="solid"];
    "6" -> "9" [label="DATA(i)", style="solid"];
    "7" -> "9" [label="DATA(j)", style="solid"];
    "5" -> "10" [label="DATA(dp)", style="solid"];
    "6" -> "10" [label="DATA(i)", style="solid"];
    "7" -> "10" [label="DATA(j)", style="solid"];
    "2" -> "11" [label="DATA(m)", style="solid"];
    "3" -> "12" [label="DATA(n)", style="solid"];
    "11" -> "13" [label="DATA(i)", style="solid"];
    "12" -> "13" [label="DATA(j)", style="solid"];
    "1" -> "13" [label="DATA(str2)", style="solid"];
    "1" -> "13" [label="DATA(str3)", style="solid"];
    "5" -> "14" [label="DATA(dp)", style="solid"];
    "11" -> "14" [label="DATA(i)", style="solid"];
    "12" -> "14" [label="DATA(j)", style="solid"];
    "5" -> "15" [label="DATA(dp)", style="solid"];
    "2" -> "15" [label="DATA(m)", style="solid"];
    "3" -> "15" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
    "6" -> "7" [label="CONTROL(For)", style="dashed"];
    "7" -> "8" [label="CONTROL(For)", style="dashed"];
    "8" -> "9" [label="CONTROL(If)", style="dashed"];
    "8" -> "10" [label="CONTROL(If)", style="dashed"];
    "1" -> "11" [label="CONTROL(FunctionDef)", style="dashed"];
