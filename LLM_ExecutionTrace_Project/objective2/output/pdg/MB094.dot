digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def max_sum(arr): | W:arr,max_sum", fillcolor="lightgreen"];
    "2" [label="L5: max_sum = 0 | W:max_sum", fillcolor="lightgrey"];
    "3" [label="L6: start, end = 0, 0 | W:end,start", fillcolor="lightgrey"];
    "4" [label="L9: for i in range(len(arr)): | W:i | R:arr,len,range", fillcolor="lightgrey"];
    "5" [label="L10: for j in range(i+1, len(arr)): | W:j | R:arr,i,len,range", fillcolor="lightgrey"];
    "6" [label="L11: if arr[i] + arr[j] > max_sum: | R:arr,i,j,max_sum", fillcolor="lightgrey"];
    "7" [label="L12: max_sum = arr[i] + arr[j] | W:max_sum | R:arr,i,j", fillcolor="lightgrey"];
    "8" [label="L13: start, end = i, j | W:end,start | R:i,j", fillcolor="lightgrey"];
    "9" [label="L16: return (max_sum, start, end) | R:end,max_sum,start", fillcolor="salmon"];

    "1" -> "4" [label="DATA(arr)", style="solid"];
    "1" -> "5" [label="DATA(arr)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "6" [label="DATA(arr)", style="solid"];
    "4" -> "6" [label="DATA(i)", style="solid"];
    "5" -> "6" [label="DATA(j)", style="solid"];
    "2" -> "6" [label="DATA(max_sum)", style="solid"];
    "1" -> "7" [label="DATA(arr)", style="solid"];
    "4" -> "7" [label="DATA(i)", style="solid"];
    "5" -> "7" [label="DATA(j)", style="solid"];
    "4" -> "8" [label="DATA(i)", style="solid"];
    "5" -> "8" [label="DATA(j)", style="solid"];
    "8" -> "9" [label="DATA(end)", style="solid"];
    "7" -> "9" [label="DATA(max_sum)", style="solid"];
    "8" -> "9" [label="DATA(start)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "6" -> "8" [label="CONTROL(If)", style="dashed"];
    "1" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
}