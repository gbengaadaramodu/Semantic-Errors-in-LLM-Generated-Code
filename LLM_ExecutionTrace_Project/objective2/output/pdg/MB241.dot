digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def intersection_array(arr1, arr2): | W:arr1,arr2,intersection_array", fillcolor="lightgreen"];
    "2" [label="L2: return list(set(arr1) & set(arr2)) | R:arr1,arr2,list,set", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr1)", style="solid"];
    "1" -> "2" [label="DATA(arr2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}