digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def convert(z): | W:z,convert", fillcolor="lightgreen"];
    "2" [label="L2: return (abs(z), math.atan2(z.imag, z.real)) | R:abs,math,z", fillcolor="salmon"];

    "1" -> "2" [label="DATA(z)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}