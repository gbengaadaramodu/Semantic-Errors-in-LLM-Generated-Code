digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def count_set_bits(n): | W:n,count_set_bits", fillcolor="lightgreen"];
    "2" [label="L2: count = 0 | W:count", fillcolor="lightgrey"];
    "3" [label="L3: while n: | R:n", fillcolor="lightgrey"];
    "4" [label="L4: count += n & 1 | W:count | R:n", fillcolor="lightgrey"];
    "5" [label="L5: n >>= 1 | W:n", fillcolor="lightgrey"];
    "6" [label="L6: return count | R:count", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n)", style="solid"];
    "1" -> "4" [label="DATA(n)", style="solid"];
    "4" -> "6" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(While)", style="dashed"];
    "3" -> "5" [label="CONTROL(While)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}