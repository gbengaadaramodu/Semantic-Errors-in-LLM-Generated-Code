digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def prime_num(n): | W:n,prime_num", fillcolor="lightgreen"];
    "2" [label="L2: if n <= 1: | R:n", fillcolor="lightgrey"];
    "3" [label="L3: return False", fillcolor="lightgrey"];
    "4" [label="L4: for i in range(2, int(n**0.5) + 1): | W:i | R:int,n,range", fillcolor="lightgrey"];
    "5" [label="L5: if n % i == 0: | R:i,n", fillcolor="lightgrey"];
    "6" [label="L6: return False", fillcolor="lightgrey"];
    "7" [label="L7: return True", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "4" [label="DATA(n)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}