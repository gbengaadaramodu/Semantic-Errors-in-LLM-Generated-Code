digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def odd_length_sum(arr): | W:arr,odd_length_sum", fillcolor="lightgreen"];
    "2" [label="L2: result = 0 | W:result", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(len(arr)): | W:i | R:arr,len,range", fillcolor="lightgreen"];
    "4" [label="L4: for j in range(i, len(arr)): | W:j | R:arr,i,len,range", fillcolor="lightgreen"];
    "5" [label="L5: if j - i + 1 % 2 == 1: | R:i,j", fillcolor="lightgreen"];
    "6" [label="L6: result += arr[j] | W:result | R:arr,j", fillcolor="lightgreen"];
    "7" [label="L7: return result | R:result", fillcolor="salmon"];

    "1" -> "3" [label="DATA(arr)", style="solid"];
    "1" -> "4" [label="DATA(arr)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "3" -> "5" [label="DATA(i)", style="solid"];
    "4" -> "5" [label="DATA(j)", style="solid"];
    "1" -> "6" [label="DATA(arr)", style="solid"];
    "4" -> "6" [label="DATA(j)", style="solid"];
    "6" -> "7" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}