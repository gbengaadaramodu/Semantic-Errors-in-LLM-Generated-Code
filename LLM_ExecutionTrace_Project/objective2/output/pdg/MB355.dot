digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def max_run_uppercase(s): | W:s,max_run_uppercase", fillcolor="lightgreen"];
    "2" [label="L2: max_count = 0 | W:max_count", fillcolor="lightgreen"];
    "3" [label="L3: current_count = 0 | W:current_count", fillcolor="lightgreen"];
    "4" [label="L4: for c in s: | W:c | R:s", fillcolor="lightgreen"];
    "5" [label="L5: if c.isupper(): | R:c", fillcolor="lightgreen"];
    "6" [label="L6: current_count += 1 | W:current_count", fillcolor="lightgreen"];
    "7" [label="L8: if current_count > max_count: | R:current_count,max_count", fillcolor="lightgreen"];
    "8" [label="L9: max_count = current_count | W:max_count | R:current_count", fillcolor="lightgreen"];
    "9" [label="L10: current_count = 0 | W:current_count", fillcolor="lightgreen"];
    "10" [label="L11: return max_count | R:max_count", fillcolor="salmon"];

    "1" -> "4" [label="DATA(s)", style="solid"];
    "4" -> "5" [label="DATA(c)", style="solid"];
    "6" -> "7" [label="DATA(current_count)", style="solid"];
    "2" -> "7" [label="DATA(max_count)", style="solid"];
    "6" -> "8" [label="DATA(current_count)", style="solid"];
    "8" -> "10" [label="DATA(max_count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "5" -> "7" [label="CONTROL(If)", style="dashed"];
    "7" -> "8" [label="CONTROL(If)", style="dashed"];
    "5" -> "9" [label="CONTROL(If)", style="dashed"];
    "1" -> "10" [label="CONTROL(FunctionDef)", style="dashed"];
}