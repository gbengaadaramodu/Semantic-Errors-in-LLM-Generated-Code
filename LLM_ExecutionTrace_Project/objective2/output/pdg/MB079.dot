digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def min_swaps(n1, n2): | W:n1,n2,min_swaps", fillcolor="lightgreen"];
    "2" [label="L2: count = 0 | W:count", fillcolor="lightgrey"];
    "3" [label="L3: for i in range(len(n1)): | W:i | R:len,n1,range", fillcolor="lightgrey"];
    "4" [label="L4: if n1[i] != n2[i]: | R:i,n1,n2", fillcolor="lightgrey"];
    "5" [label="L5: count += 1 | W:count", fillcolor="lightgrey"];
    "6" [label="L6: return count | R:count", fillcolor="salmon"];

    "1" -> "3" [label="DATA(n1)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "1" -> "4" [label="DATA(n1)", style="solid"];
    "1" -> "4" [label="DATA(n2)", style="solid"];
    "5" -> "6" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}