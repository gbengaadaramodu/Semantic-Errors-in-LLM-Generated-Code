digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def noprofit_noloss(amount, cost): | W:amount,cost,noprofit_noloss", fillcolor="lightgreen"];
    "2" [label="L2: return amount == cost | R:amount,cost", fillcolor="salmon"];

    "1" -> "2" [label="DATA(amount)", style="solid"];
    "1" -> "2" [label="DATA(cost)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}