digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sort_third(l): | W:l,sort_third", fillcolor="lightgreen"];
    "2" [label="L2: l_copy = l.copy() | W:l_copy | R:l", fillcolor="lightgreen"];
    "3" [label="L3: for i in range(len(l)): | W:i | R:l,len,range", fillcolor="lightgreen"];
    "4" [label="L4: if i % 3 == 0: | R:i", fillcolor="lightgreen"];
    "5" [label="L5: continue", fillcolor="lightgreen"];
    "6" [label="L7: l_copy[i] = sorted(l_copy[i]) | R:i,l_copy,sorted", fillcolor="salmon"];
    "7" [label="L8: return l_copy | R:l_copy", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(l)", style="solid"];
    "1" -> "3" [label="DATA(l)", style="solid"];
    "3" -> "4" [label="DATA(i)", style="solid"];
    "3" -> "6" [label="DATA(i)", style="solid"];
    "2" -> "6" [label="DATA(l_copy)", style="solid"];
    "2" -> "7" [label="DATA(l_copy)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "4" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}