digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def average_tuple(tuple_of_tuples): | W:tuple_of_tuples,average_tuple", fillcolor="lightgreen"];
    "2" [label="L2: return [sum(t)/len(t) for t in tuple_of_tuples] | W:t | R:len,sum,t,tuple_of_tuples", fillcolor="salmon"];

    "1" -> "2" [label="DATA(tuple_of_tuples)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}