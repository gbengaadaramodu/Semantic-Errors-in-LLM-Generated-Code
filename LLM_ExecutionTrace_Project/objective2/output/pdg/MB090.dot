digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_max_num(my_list): | W:my_list,find_max_num", fillcolor="lightgreen"];
    "2" [label="L2: return int(\"\".join(sorted(my_list, reverse=True))) | R:int,my_list,sorted", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_list)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}