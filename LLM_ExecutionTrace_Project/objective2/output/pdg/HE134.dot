digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_max(words): | W:words,find_max", fillcolor="lightgreen"];
    "2" [label="L2: max_word = \"\" | W:max_word", fillcolor="lightgreen"];
    "3" [label="L3: for word in words: | W:word | R:words", fillcolor="lightgreen"];
    "4" [label="L4: if len(set(word)) > len(set(max_word)): | R:len,max_word,set,word", fillcolor="lightgreen"];
    "5" [label="L5: max_word = word | W:max_word | R:word", fillcolor="lightgreen"];
    "6" [label="L6: return max_word | R:max_word", fillcolor="salmon"];

    "1" -> "3" [label="DATA(words)", style="solid"];
    "2" -> "4" [label="DATA(max_word)", style="solid"];
    "3" -> "4" [label="DATA(word)", style="solid"];
    "3" -> "5" [label="DATA(word)", style="solid"];
    "5" -> "6" [label="DATA(max_word)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
}