digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def make_palindrome(string: str) -> str: | W:string,make_palindrome | R:str", fillcolor="lightgreen"];
    "2" [label="L2: if is_palindrome(string): | R:is_palindrome,string", fillcolor="salmon"];
    "3" [label="L3: return string | R:string", fillcolor="lightgrey"];
    "4" [label="L5: longest_postfix = \"\" | W:longest_postfix", fillcolor="lightgrey"];
    "5" [label="L6: for i in range(len(string), 0, -1): | W:i | R:len,range,string", fillcolor="lightgrey"];
    "6" [label="L7: if is_palindrome(string[:i]): | R:i,is_palindrome,string", fillcolor="lightgrey"];
    "7" [label="L8: longest_postfix = string[i:] | W:longest_postfix | R:i,string", fillcolor="lightgrey"];
    "8" [label="L9: break", fillcolor="lightgrey"];
    "9" [label="L11: return string + longest_postfix[::-1] | R:longest_postfix,string", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "3" [label="DATA(string)", style="solid"];
    "1" -> "5" [label="DATA(string)", style="solid"];
    "5" -> "6" [label="DATA(i)", style="solid"];
    "1" -> "6" [label="DATA(string)", style="solid"];
    "5" -> "7" [label="DATA(i)", style="solid"];
    "1" -> "7" [label="DATA(string)", style="solid"];
    "7" -> "9" [label="DATA(longest_postfix)", style="solid"];
    "1" -> "9" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
    "5" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(If)", style="dashed"];
    "6" -> "8" [label="CONTROL(If)", style="dashed"];
    "1" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
}