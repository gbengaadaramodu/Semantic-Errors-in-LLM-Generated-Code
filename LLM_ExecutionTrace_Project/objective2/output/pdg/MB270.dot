digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def area_tetrahedron(side): | W:side,area_tetrahedron", fillcolor="lightgreen"];
    "2" [label="L2: area = (side ** 2) * sqrt(2) / 2 | W:area | R:side,sqrt", fillcolor="salmon"];
    "3" [label="L3: return area | R:area", fillcolor="lightgrey"];

    "1" -> "2" [label="DATA(side)", style="solid"];
    "2" -> "3" [label="DATA(area)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
}