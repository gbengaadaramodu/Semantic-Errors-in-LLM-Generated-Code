digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def remove_uppercase(string): | W:string,remove_uppercase", fillcolor="lightgreen"];
    "2" [label="L2: return ''.join([char for char in string if char.islower()]) | W:char | R:char,string", fillcolor="salmon"];

    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}