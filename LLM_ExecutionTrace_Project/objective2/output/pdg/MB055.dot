digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def surfacearea_cylinder(radius, height): | W:height,radius,surfacearea_cylinder", fillcolor="lightgreen"];
    "2" [label="L2: return 2 * math.pi * radius * (height + radius) | R:height,math,radius", fillcolor="salmon"];

    "1" -> "2" [label="DATA(height)", style="solid"];
    "1" -> "2" [label="DATA(radius)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}