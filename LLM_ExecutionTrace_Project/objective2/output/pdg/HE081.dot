digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def prime_length(string): | W:string,prime_length", fillcolor="lightgreen"];
    "2" [label="L2: if len(string) == 1: | R:len,string", fillcolor="lightgreen"];
    "3" [label="L3: return True", fillcolor="lightgrey"];
    "4" [label="L4: for i in range(2, int(len(string) ** 0.5) + 1): | W:i | R:int,len,range,string", fillcolor="lightgreen"];
    "5" [label="L5: if len(string) % i == 0: | R:i,len,string", fillcolor="lightgreen"];
    "6" [label="L6: return False", fillcolor="lightgreen"];
    "7" [label="L7: return True", fillcolor="salmon"];

    "1" -> "2" [label="DATA(string)", style="solid"];
    "1" -> "4" [label="DATA(string)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(string)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "2" -> "3" [label="CONTROL(If)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}