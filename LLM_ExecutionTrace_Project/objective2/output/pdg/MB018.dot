digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def find_solution(a, b, n): | W:a,b,n,find_solution", fillcolor="lightgreen"];
    "2" [label="L2: x = 0 | W:x", fillcolor="lightgrey"];
    "3" [label="L3: y = 0 | W:y", fillcolor="lightgrey"];
    "4" [label="L4: for i in range(n): | W:i | R:n,range", fillcolor="lightgrey"];
    "5" [label="L5: if a*i + b*y == n: | R:a,b,i,n,y", fillcolor="lightgrey"];
    "6" [label="L6: x = i | W:x | R:i", fillcolor="lightgrey"];
    "7" [label="L7: break", fillcolor="lightgrey"];
    "8" [label="L8: for j in range(n): | W:j | R:n,range", fillcolor="lightgrey"];
    "9" [label="L9: if a*x + b*j == n: | R:a,b,j,n,x", fillcolor="lightgrey"];
    "10" [label="L10: y = j | W:y | R:j", fillcolor="lightgrey"];
    "11" [label="L11: break", fillcolor="lightgrey"];
    "12" [label="L12: if x==0 and y==0: | R:x,y", fillcolor="lightgrey"];
    "13" [label="L13: return None", fillcolor="lightgrey"];
    "14" [label="L15: return (x,y) | R:x,y", fillcolor="salmon"];

    "1" -> "4" [label="DATA(n)", style="solid"];
    "1" -> "5" [label="DATA(a)", style="solid"];
    "1" -> "5" [label="DATA(b)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "3" -> "5" [label="DATA(y)", style="solid"];
    "4" -> "6" [label="DATA(i)", style="solid"];
    "1" -> "8" [label="DATA(n)", style="solid"];
    "1" -> "9" [label="DATA(a)", style="solid"];
    "1" -> "9" [label="DATA(b)", style="solid"];
    "8" -> "9" [label="DATA(j)", style="solid"];
    "1" -> "9" [label="DATA(n)", style="solid"];
    "6" -> "9" [label="DATA(x)", style="solid"];
    "8" -> "10" [label="DATA(j)", style="solid"];
    "6" -> "12" [label="DATA(x)", style="solid"];
    "10" -> "12" [label="DATA(y)", style="solid"];
    "6" -> "14" [label="DATA(x)", style="solid"];
    "10" -> "14" [label="DATA(y)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "5" -> "7" [label="CONTROL(If)", style="dashed"];
    "1" -> "8" [label="CONTROL(FunctionDef)", style="dashed"];
    "8" -> "9" [label="CONTROL(For)", style="dashed"];
    "9" -> "10" [label="CONTROL(If)", style="dashed"];
    "9" -> "11" [label="CONTROL(If)", style="dashed"];
    "1" -> "12" [label="CONTROL(FunctionDef)", style="dashed"];
    "12" -> "13" [label="CONTROL(If)", style="dashed"];
    "12" -> "14" [label="CONTROL(If)", style="dashed"];
}