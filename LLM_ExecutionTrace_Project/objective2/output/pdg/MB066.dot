digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def overlapping(seq1, seq2): | W:seq1,seq2,overlapping", fillcolor="lightgreen"];
    "2" [label="L2: return any(x in seq2 for x in seq1) | W:x | R:any,seq1,seq2,x", fillcolor="salmon"];

    "1" -> "2" [label="DATA(seq1)", style="solid"];
    "1" -> "2" [label="DATA(seq2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}