digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sum_names(names): | W:names,sum_names", fillcolor="lightgreen"];
    "2" [label="L2: return sum(len(name) for name in names if name[0].isupper()) | W:name | R:len,name,names,sum", fillcolor="salmon"];

    "1" -> "2" [label="DATA(names)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}