digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def double_the_difference(lst): | W:lst,double_the_difference", fillcolor="lightgreen"];
    "2" [label="L2: result = 0 | W:result", fillcolor="lightgreen"];
    "3" [label="L3: for num in lst: | W:num | R:lst", fillcolor="lightgreen"];
    "4" [label="L4: if num < 0 or not num.is_integer(): | R:num", fillcolor="lightgreen"];
    "5" [label="L5: continue", fillcolor="lightgrey"];
    "6" [label="L6: result += (num * num) | W:result | R:num", fillcolor="lightgreen"];
    "7" [label="L7: return result | R:result", fillcolor="salmon"];

    "1" -> "3" [label="DATA(lst)", style="solid"];
    "3" -> "4" [label="DATA(num)", style="solid"];
    "3" -> "6" [label="DATA(num)", style="solid"];
    "6" -> "7" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "3" -> "6" [label="CONTROL(For)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}