digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def encode(message): | W:message,encode", fillcolor="lightgreen"];
    "2" [label="L2: encoded_msg = '' | W:encoded_msg", fillcolor="lightgreen"];
    "3" [label="L3: for char in message: | W:char | R:message", fillcolor="lightgreen"];
    "4" [label="L4: if char.isalpha(): | R:char", fillcolor="lightgreen"];
    "5" [label="L5: if char.islower(): | R:char", fillcolor="lightgreen"];
    "6" [label="L6: encoded_msg += chr(ord('a') + (ord(char) - ord('a') + 2) % 26) | W:encoded_msg | R:char,chr,ord", fillcolor="lightgrey"];
    "7" [label="L8: encoded_msg += chr(ord('A') + (ord(char) - ord('A') + 2) % 26) | W:encoded_msg | R:char,chr,ord", fillcolor="lightgreen"];
    "8" [label="L10: encoded_msg += char | W:encoded_msg | R:char", fillcolor="lightgrey"];
    "9" [label="L11: return encoded_msg | R:encoded_msg", fillcolor="salmon"];

    "1" -> "3" [label="DATA(message)", style="solid"];
    "3" -> "4" [label="DATA(char)", style="solid"];
    "3" -> "5" [label="DATA(char)", style="solid"];
    "3" -> "6" [label="DATA(char)", style="solid"];
    "3" -> "7" [label="DATA(char)", style="solid"];
    "3" -> "8" [label="DATA(char)", style="solid"];
    "8" -> "9" [label="DATA(encoded_msg)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "4" -> "5" [label="CONTROL(If)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "5" -> "7" [label="CONTROL(If)", style="dashed"];
    "4" -> "8" [label="CONTROL(If)", style="dashed"];
    "1" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
}