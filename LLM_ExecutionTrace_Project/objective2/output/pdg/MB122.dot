digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def div_list(list1, list2): | W:list1,list2,div_list", fillcolor="lightgreen"];
    "2" [label="L2: return [i / j for i, j in zip(list1, list2)] | W:i,j | R:i,j,list1,list2,zip", fillcolor="salmon"];

    "1" -> "2" [label="DATA(list1)", style="solid"];
    "1" -> "2" [label="DATA(list2)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}