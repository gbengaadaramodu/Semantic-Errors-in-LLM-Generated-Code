digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def tup_string(my_tuple): | W:my_tuple,tup_string", fillcolor="lightgreen"];
    "2" [label="L2: return \"\".join(my_tuple) | R:my_tuple", fillcolor="salmon"];

    "1" -> "2" [label="DATA(my_tuple)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}