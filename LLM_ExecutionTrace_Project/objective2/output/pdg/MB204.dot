digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def odd_equivalent(binary_string, num_rotations): | W:binary_string,num_rotations,odd_equivalent", fillcolor="lightgreen"];
    "2" [label="L3: num_odd_values = 0 | W:num_odd_values", fillcolor="lightgrey"];
    "3" [label="L6: for i in range(num_rotations): | W:i | R:num_rotations,range", fillcolor="lightgrey"];
    "4" [label="L8: num = int(binary_string, 2) | W:num | R:binary_string,int", fillcolor="lightgrey"];
    "5" [label="L11: if num % 2 == 1: | R:num", fillcolor="lightgrey"];
    "6" [label="L13: num_odd_values += 1 | W:num_odd_values", fillcolor="lightgrey"];
    "7" [label="L16: return num_odd_values | R:num_odd_values", fillcolor="salmon"];

    "1" -> "3" [label="DATA(num_rotations)", style="solid"];
    "1" -> "4" [label="DATA(binary_string)", style="solid"];
    "4" -> "5" [label="DATA(num)", style="solid"];
    "6" -> "7" [label="DATA(num_odd_values)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "3" -> "4" [label="CONTROL(For)", style="dashed"];
    "3" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(If)", style="dashed"];
    "1" -> "7" [label="CONTROL(FunctionDef)", style="dashed"];
}