digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def simplify(x, n): | W:n,x,simplify", fillcolor="lightgreen"];
    "2" [label="L2: num1, denom1 = x.split('/') | W:denom1,num1 | R:x", fillcolor="lightgreen"];
    "3" [label="L3: num2, denom2 = n.split('/') | W:denom2,num2 | R:n", fillcolor="lightgreen"];
    "4" [label="L4: result = str(int(num1) * int(denom2)) + '/' + str(int(num2) * int(denom1)) | W:result | R:denom1,denom2,int,num1,num2,str", fillcolor="lightgreen"];
    "5" [label="L5: return result.endswith('/1') | R:result", fillcolor="salmon"];

    "1" -> "2" [label="DATA(x)", style="solid"];
    "1" -> "3" [label="DATA(n)", style="solid"];
    "2" -> "4" [label="DATA(denom1)", style="solid"];
    "3" -> "4" [label="DATA(denom2)", style="solid"];
    "2" -> "4" [label="DATA(num1)", style="solid"];
    "3" -> "4" [label="DATA(num2)", style="solid"];
    "4" -> "5" [label="DATA(result)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
}