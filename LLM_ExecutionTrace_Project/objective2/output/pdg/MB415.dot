digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def colon_tuple(my_tuple, start, end): | W:end,my_tuple,start,colon_tuple", fillcolor="lightgreen"];
    "2" [label="L2: return my_tuple[:start] + (end,) + my_tuple[start+1:] | R:end,my_tuple,start", fillcolor="salmon"];

    "1" -> "2" [label="DATA(end)", style="solid"];
    "1" -> "2" [label="DATA(my_tuple)", style="solid"];
    "1" -> "2" [label="DATA(start)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
}