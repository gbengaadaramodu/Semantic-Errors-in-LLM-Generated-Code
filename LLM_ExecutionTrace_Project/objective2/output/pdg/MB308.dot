digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def sum_Of_Subarray_Prod(arr): | W:arr,sum_Of_Subarray_Prod", fillcolor="lightgreen"];
    "2" [label="L2: n = len(arr) | W:n | R:arr,len", fillcolor="lightgreen"];
    "3" [label="L3: dp = [[0 for _ in range(n+1)] for _ in range(n+1)] | W:_,dp | R:n,range", fillcolor="lightgreen"];
    "4" [label="L5: for i in range(n+1): | W:i | R:n,range", fillcolor="lightgreen"];
    "5" [label="L6: dp[i][0] = 1 | R:dp,i", fillcolor="lightgreen"];
    "6" [label="L8: for j in range(1, n+1): | W:j | R:n,range", fillcolor="lightgreen"];
    "7" [label="L9: for i in range(j): | W:i | R:j,range", fillcolor="lightgreen"];
    "8" [label="L10: dp[i][j] = dp[i][j-1] * arr[j-1] | R:arr,dp,i,j", fillcolor="lightgreen"];
    "9" [label="L12: for i in range(n+1): | W:i | R:n,range", fillcolor="lightgreen"];
    "10" [label="L13: for j in range(i+1, n+1): | W:j | R:i,n,range", fillcolor="lightgreen"];
    "11" [label="L14: dp[i][j] += dp[i][j-1] | R:dp,i,j", fillcolor="lightgreen"];
    "12" [label="L16: return dp[0][n] | R:dp,n", fillcolor="salmon"];

    "1" -> "2" [label="DATA(arr)", style="solid"];
    "2" -> "3" [label="DATA(n)", style="solid"];
    "2" -> "4" [label="DATA(n)", style="solid"];
    "3" -> "5" [label="DATA(dp)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "2" -> "6" [label="DATA(n)", style="solid"];
    "6" -> "7" [label="DATA(j)", style="solid"];
    "1" -> "8" [label="DATA(arr)", style="solid"];
    "3" -> "8" [label="DATA(dp)", style="solid"];
    "7" -> "8" [label="DATA(i)", style="solid"];
    "6" -> "8" [label="DATA(j)", style="solid"];
    "2" -> "9" [label="DATA(n)", style="solid"];
    "9" -> "10" [label="DATA(i)", style="solid"];
    "2" -> "10" [label="DATA(n)", style="solid"];
    "3" -> "11" [label="DATA(dp)", style="solid"];
    "9" -> "11" [label="DATA(i)", style="solid"];
    "10" -> "11" [label="DATA(j)", style="solid"];
    "3" -> "12" [label="DATA(dp)", style="solid"];
    "2" -> "12" [label="DATA(n)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
    "6" -> "7" [label="CONTROL(For)", style="dashed"];
    "7" -> "8" [label="CONTROL(For)", style="dashed"];
    "1" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
    "9" -> "10" [label="CONTROL(For)", style="dashed"];
    "10" -> "11" [label="CONTROL(For)", style="dashed"];
    "1" -> "12" [label="CONTROL(FunctionDef)", style="dashed"];
}