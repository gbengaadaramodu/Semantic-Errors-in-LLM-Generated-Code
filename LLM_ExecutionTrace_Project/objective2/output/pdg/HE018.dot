digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def minPath(grid, k): | W:grid,k,minPath", fillcolor="lightgreen"];
    "2" [label="L2: rows = len(grid) | W:rows | R:grid,len", fillcolor="lightgreen"];
    "3" [label="L3: cols = len(grid[0]) | W:cols | R:grid,len", fillcolor="lightgreen"];
    "4" [label="L4: visited = set() | W:visited | R:set", fillcolor="lightgreen"];
    "5" [label="L5: queue = [(0, 0, 1)] | W:queue", fillcolor="lightgreen"];
    "6" [label="L6: while queue: | R:queue", fillcolor="lightgreen"];
    "7" [label="L7: row, col, length = queue.pop(0) | W:col,length,row | R:queue", fillcolor="lightgreen"];
    "8" [label="L8: if (row, col) in visited: | R:col,row,visited", fillcolor="lightgreen"];
    "9" [label="L9: continue", fillcolor="lightgreen"];
    "10" [label="L10: visited.add((row, col)) | R:col,row,visited", fillcolor="lightgreen"];
    "11" [label="L11: if length == k: | R:k,length", fillcolor="lightgreen"];
    "12" [label="L12: return grid[row][col] | R:col,grid,row", fillcolor="lightgreen"];
    "13" [label="L13: for r, c in [(row-1, col), (row+1, col), (row, col-1), (row, col+1)]: | W:c,r | R:col,row", fillcolor="lightgreen"];
    "14" [label="L14: if 0 <= r < rows and 0 <= c < cols: | R:c,cols,r,rows", fillcolor="lightgreen"];
    "15" [label="L15: queue.append((r, c, length+1)) | R:c,length,queue,r", fillcolor="lightgreen"];
    "16" [label="L16: return []", fillcolor="salmon"];

    "1" -> "2" [label="DATA(grid)", style="solid"];
    "1" -> "3" [label="DATA(grid)", style="solid"];
    "5" -> "6" [label="DATA(queue)", style="solid"];
    "5" -> "7" [label="DATA(queue)", style="solid"];
    "7" -> "8" [label="DATA(col)", style="solid"];
    "7" -> "8" [label="DATA(row)", style="solid"];
    "4" -> "8" [label="DATA(visited)", style="solid"];
    "7" -> "10" [label="DATA(col)", style="solid"];
    "7" -> "10" [label="DATA(row)", style="solid"];
    "4" -> "10" [label="DATA(visited)", style="solid"];
    "1" -> "11" [label="DATA(k)", style="solid"];
    "7" -> "11" [label="DATA(length)", style="solid"];
    "7" -> "12" [label="DATA(col)", style="solid"];
    "1" -> "12" [label="DATA(grid)", style="solid"];
    "7" -> "12" [label="DATA(row)", style="solid"];
    "7" -> "13" [label="DATA(col)", style="solid"];
    "7" -> "13" [label="DATA(row)", style="solid"];
    "13" -> "14" [label="DATA(c)", style="solid"];
    "3" -> "14" [label="DATA(cols)", style="solid"];
    "13" -> "14" [label="DATA(r)", style="solid"];
    "2" -> "14" [label="DATA(rows)", style="solid"];
    "13" -> "15" [label="DATA(c)", style="solid"];
    "7" -> "15" [label="DATA(length)", style="solid"];
    "5" -> "15" [label="DATA(queue)", style="solid"];
    "13" -> "15" [label="DATA(r)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "5" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "6" [label="CONTROL(FunctionDef)", style="dashed"];
    "6" -> "7" [label="CONTROL(While)", style="dashed"];
    "6" -> "8" [label="CONTROL(While)", style="dashed"];
    "8" -> "9" [label="CONTROL(If)", style="dashed"];
    "6" -> "10" [label="CONTROL(While)", style="dashed"];
    "6" -> "11" [label="CONTROL(While)", style="dashed"];
    "11" -> "12" [label="CONTROL(If)", style="dashed"];
    "6" -> "13" [label="CONTROL(While)", style="dashed"];
    "13" -> "14" [label="CONTROL(For)", style="dashed"];
    "14" -> "15" [label="CONTROL(If)", style="dashed"];
    "1" -> "16" [label="CONTROL(FunctionDef)", style="dashed"];
}