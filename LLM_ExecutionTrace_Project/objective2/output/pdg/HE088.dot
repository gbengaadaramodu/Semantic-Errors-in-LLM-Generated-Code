digraph PDG {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=white, fontname="Courier"];
    edge [fontname="Helvetica", fontsize=9];

    "1" [label="L1: def get_max_triples(n): | W:n,get_max_triples", fillcolor="lightgreen"];
    "2" [label="L2: a = [i*i-i+1 for i in range(1, n+1)] | W:a,i | R:i,n,range", fillcolor="lightgreen"];
    "3" [label="L3: count = 0 | W:count", fillcolor="lightgreen"];
    "4" [label="L4: for i in range(n-2): | W:i | R:n,range", fillcolor="lightgreen"];
    "5" [label="L5: for j in range(i+1, n-1): | W:j | R:i,n,range", fillcolor="lightgreen"];
    "6" [label="L6: for k in range(j+1, n): | W:k | R:j,n,range", fillcolor="lightgreen"];
    "7" [label="L7: if a[i] + a[j] + a[k] % 3 == 0: | R:a,i,j,k", fillcolor="lightgreen"];
    "8" [label="L8: count += 1 | W:count", fillcolor="lightgrey"];
    "9" [label="L9: return count | R:count", fillcolor="salmon"];

    "1" -> "2" [label="DATA(n)", style="solid"];
    "1" -> "4" [label="DATA(n)", style="solid"];
    "4" -> "5" [label="DATA(i)", style="solid"];
    "1" -> "5" [label="DATA(n)", style="solid"];
    "5" -> "6" [label="DATA(j)", style="solid"];
    "1" -> "6" [label="DATA(n)", style="solid"];
    "2" -> "7" [label="DATA(a)", style="solid"];
    "4" -> "7" [label="DATA(i)", style="solid"];
    "5" -> "7" [label="DATA(j)", style="solid"];
    "6" -> "7" [label="DATA(k)", style="solid"];
    "8" -> "9" [label="DATA(count)", style="solid"];
    "1" -> "2" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "3" [label="CONTROL(FunctionDef)", style="dashed"];
    "1" -> "4" [label="CONTROL(FunctionDef)", style="dashed"];
    "4" -> "5" [label="CONTROL(For)", style="dashed"];
    "5" -> "6" [label="CONTROL(For)", style="dashed"];
    "6" -> "7" [label="CONTROL(For)", style="dashed"];
    "7" -> "8" [label="CONTROL(If)", style="dashed"];
    "1" -> "9" [label="CONTROL(FunctionDef)", style="dashed"];
}